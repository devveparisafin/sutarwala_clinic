@{
    ViewData["Title"] = "Manufacturers";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-industry me-2"></i>Manufacturers</h1>
        <button type="button" class="btn btn-primary shadow-sm" onclick="showModal()">
            <i class="fas fa-plus fa-sm text-white-50"></i> Add New Manufacturer
        </button>
    </div>

    <div class="card shadow mb-4 border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="dataTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Manufacturer Name</th>
                            <th>Contact Info</th>
                            <th>Address</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="upsertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalTitle">Add Manufacturer</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="upsertForm">
                <div class="modal-body p-4">
                    <input type="hidden" id="Id" name="Id" />
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label for="Name" class="form-label fw-bold">Manufacturer Name</label>
                            <input type="text" class="form-control" id="Name" name="Name" required />
                        </div>
                        <div class="col-md-6">
                            <label for="Email" class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control" id="Email" name="Email" />
                        </div>
                        <div class="col-md-6">
                            <label for="Phone" class="form-label fw-bold">Phone</label>
                            <input type="text" class="form-control" id="Phone" name="Phone" />
                        </div>
                        <div class="col-md-12">
                            <label for="Address" class="form-label fw-bold">Address</label>
                            <textarea class="form-control" id="Address" name="Address" rows="2"></textarea>
                        </div>
                        <div class="col-md-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" checked value="true">
                                <label class="form-check-label fw-bold" for="IsActive">Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var dataTable;

        $(document).ready(function () {
            loadDataTable();

            $("#upsertForm").submit(function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                
                $.post("/Manufacturer/Upsert", formData, function (data) {
                    if (data.success) {
                        toastr.success(data.message);
                        $("#upsertModal").modal("hide");
                        dataTable.ajax.reload();
                    } else {
                        toastr.error(data.message);
                    }
                });
            });
        });

        function loadDataTable() {
            dataTable = $('#dataTable').DataTable({
                "ajax": { "url": "/Manufacturer/GetAll" },
                "columns": [
                    { "data": "name", "width": "25%" },
                    { 
                        "data": null,
                        "render": function(data) {
                            var html = "";
                            if(data.email) html += `<div><i class="fas fa-envelope me-1 small"></i> ${data.email}</div>`;
                            if(data.phone) html += `<div><i class="fas fa-phone me-1 small"></i> ${data.phone}</div>`;
                            return html || '<span class="text-muted small">N/A</span>';
                        },
                        "width": "20%" 
                    },
                    { "data": "address", "width": "25%" },
                    { 
                        "data": "isActive", 
                        "render": function(data) {
                            return data ? '<span class="badge bg-success">Active</span>' : '<span class="badge bg-danger">Inactive</span>';
                        },
                        "width": "10%" 
                    },
                    {
                        "data": "id",
                        "render": function (data) {
                            return `
                                <div class="text-center">
                                    <button onclick="edit('${data}')" class="btn btn-sm btn-info text-white me-1">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                    <button onclick="deleteItem('${data}')" class="btn btn-sm btn-danger">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>`;
                        },
                        "width": "20%"
                    }
                ]
            });
        }

        function showModal() {
            $("#upsertForm")[0].reset();
            $("#Id").val("");
            $("#modalTitle").text("Add Manufacturer");
            $("#upsertModal").modal("show");
        }

        function edit(id) {
            $.get("/Manufacturer/GetById/" + id, function (data) {
                $("#Id").val(data.id);
                $("#Name").val(data.name);
                $("#Email").val(data.email);
                $("#Phone").val(data.phone);
                $("#Address").val(data.address);
                $("#IsActive").prop("checked", data.isActive);
                $("#modalTitle").text("Edit Manufacturer");
                $("#upsertModal").modal("show");
            });
        }

        function deleteItem(id) {
            Swal.fire({
                title: 'Are you sure?',
                text: "You won't be able to revert this!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, delete it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: "/Manufacturer/Delete/" + id,
                        type: "DELETE",
                        success: function (data) {
                            if (data.success) {
                                toastr.success(data.message);
                                dataTable.ajax.reload();
                            } else {
                                toastr.error(data.message);
                            }
                        }
                    });
                }
            });
        }
    </script>
}
