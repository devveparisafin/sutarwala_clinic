@inject PharmacyERP.Web.Interfaces.ISettingsService SettingsService
@{
    var settings = await SettingsService.GetSettingsAsync();
    var logoPath = settings?.LogoPath ?? "/img/logo.jpg";
    var storeName = settings?.StoreName ?? "PHARMACY ERP";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @storeName</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/lib/select2/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2/select2-bootstrap-5-theme.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PharmacyERP.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <div class="bg-dark border-right text-white" id="sidebar-wrapper" style="min-width: 250px; min-height: 100vh; display: none;">
            <div class="sidebar-heading p-3 border-bottom border-secondary text-center">
                <img src="@logoPath" alt="Logo" style="height: 60px; width: auto; background: white; padding: 5px; border-radius: 50%; margin-bottom: 10px;" />
                <div class="fs-5 fw-bold text-white">@storeName</div>
            </div>
            <div class="list-group list-group-flush mt-3 px-2">
                @if (User.IsInRole("Doctor"))
                {
                    <a asp-controller="DoctorPrescription" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-file-medical me-2"></i> My Prescriptions
                    </a>
                    <a asp-controller="DoctorPrescription" asp-action="Create" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-plus me-2"></i> New Prescription
                    </a>
                }
                else
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-tachometer-alt me-2"></i> Dashboard
                    </a>
                    <a asp-controller="DoctorPrescription" asp-action="Queue" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1 position-relative">
                        <i class="fas fa-notes-medical me-2 text-warning"></i> Prescription Queue
                        <span class="badge bg-danger rounded-pill position-absolute end-0 me-3 d-none" id="sidebarQueueBadge" style="font-size: 0.72rem;">0</span>
                    </a>
                    <div class="text-muted small fw-bold text-uppercase px-3 mt-2 mb-1">Inventory Management</div>
                    <a asp-controller="MedicineCategory" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-tags me-2"></i> Medicine Category
                    </a>
                    <a asp-controller="MedicineUnit" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-balance-scale me-2"></i> Medicine Unit
                    </a>
                    <a asp-controller="Manufacturer" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-industry me-2"></i> Manufacturer
                    </a>
                    <a asp-controller="GenericMedicine" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-microscope me-2"></i> Generic Medicine
                    </a>
                    <a asp-controller="Rack" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-th me-2"></i> Rack & Shelf
                    </a>
                    <a asp-controller="Medicines" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-pills me-2"></i> Medicines
                    </a>
                    <a asp-controller="Inventory" asp-action="StockSummary" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-boxes me-2"></i> Inventory
                    </a>
                    <a asp-controller="Suppliers" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-truck me-2"></i> Suppliers
                    </a>
                    <a asp-controller="Customers" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-users me-2"></i> Customers
                    </a>
                    <a asp-controller="Purchases" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-shopping-cart me-2"></i> Purchases
                    </a>
                    <a asp-controller="Purchases" asp-action="Return" class="list-group-item list-group-item-action bg-dark text-white border-0 py-2 rounded mb-1 small ms-2">
                        <i class="fas fa-undo-alt me-2"></i> Purchase Return
                    </a>
                    <a asp-controller="Sales" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-file-invoice me-2"></i> Sales History
                    </a>
                    <a asp-controller="Sales" asp-action="Return" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-undo-alt me-2"></i> Sale Return
                    </a>
                    <a asp-controller="Reports" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-chart-bar me-2"></i> Reports
                    </a>
                    <a asp-controller="Settings" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                        <i class="fas fa-cog me-2"></i> Settings
                    </a>
                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Users" asp-action="Index" class="list-group-item list-group-item-action bg-dark text-white border-0 py-3 rounded mb-1">
                            <i class="fas fa-user-shield me-2"></i> User Management
                        </a>
                    }
                    <div class="mt-4 px-2">
                        <a asp-controller="Sales" asp-action="Pos" class="btn btn-primary w-100 py-3 fw-bold">
                            <i class="fas fa-cash-register me-2"></i> POS BILLING
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Page Content -->
        <div id="page-content-wrapper" class="flex-grow-1 bg-light">
            <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm py-3 px-4 mb-4">
                <div class="container-fluid">
                    <button class="btn btn-outline-primary btn-sm" id="menu-toggle"><i class="fas fa-bars"></i></button>
                    @if (!User.IsInRole("Doctor"))
                    {
                        <a href="/Sales/Pos" class="btn btn-primary btn-sm ms-3 fw-bold shadow-sm"><i class="fas fa-cash-register me-1"></i> POS Billing</a>
                        <a href="/Purchases" class="btn btn-outline-primary btn-sm ms-2 fw-bold shadow-sm"><i class="fas fa-shopping-cart me-1"></i> Purchases</a>
                    }

                    <!-- Connectivity Status Indicator -->
                    <span id="connectivityBadge" class="badge ms-3 px-2 py-1 d-flex align-items-center gap-1" style="font-size:0.72rem;">
                        <span id="connectivityDot" style="width:8px;height:8px;border-radius:50%;display:inline-block;background:#10b981;box-shadow:0 0 6px #10b981;"></span>
                        <span id="connectivityText">Online</span>
                    </span>

                    <div class="ms-auto d-flex align-items-center gap-3">
                        @if (!User.IsInRole("Doctor"))
                        {
                            <!-- Low Stock Notification Bell -->
                            <button class="btn btn-light btn-sm position-relative rounded-circle p-2" id="btnLowStockBell" onclick="openLowStockPanel()" title="Low Stock Alerts" style="width:38px;height:38px;">
                                <i class="fas fa-bell text-warning" style="font-size:1rem;"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger d-none" id="lowStockBadge" style="font-size:0.65rem;">0</span>
                            </button>
                        }

                        <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle fw-bold text-dark" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="navbarDropdown">
                                        <a class="dropdown-item py-2" asp-controller="Account" asp-action="Profile"><i class="fas fa-user me-2 small"></i> Profile</a>
                                        <div class="dropdown-divider"></div>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item py-2 text-danger"><i class="fas fa-sign-out-alt me-2 small"></i> Logout</button>
                                        </form>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid px-4">
                <main role="main" class="pb-3">
                    @RenderBody()
                </main>
            </div>
        </div>
    </div>

    <!-- ===== LOW STOCK SIDEBAR PANEL ===== -->
    <div id="lowStockOverlay" onclick="closeLowStockPanel()" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:1049;backdrop-filter:blur(2px);transition:opacity 0.2s;"></div>
    <div id="lowStockPanel" style="position:fixed;top:0;right:-420px;width:400px;height:100vh;background:#fff;z-index:1050;box-shadow:-6px 0 30px rgba(0,0,0,0.15);transition:right 0.3s cubic-bezier(.4,0,.2,1);display:flex;flex-direction:column;">
        <!-- Panel Header -->
        <div style="background:linear-gradient(135deg,#1e3a5f,#2563eb);padding:1.25rem 1.5rem;color:white;flex-shrink:0;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="m-0 fw-bold"><i class="fas fa-bell me-2"></i>Low Stock Alerts</h5>
                    <small class="opacity-75" id="lowStockSubtitle">Loading...</small>
                </div>
                <button onclick="closeLowStockPanel()" class="btn btn-sm" style="color:white;background:rgba(255,255,255,0.15);border:none;border-radius:50%;width:34px;height:34px;padding:0;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Quick Action Bar -->
        <div style="background:#f0f4ff;border-bottom:1px solid #e2e8f0;padding:0.6rem 1.5rem;" class="d-flex align-items-center justify-content-between">
            <span class="text-muted small"><i class="fas fa-info-circle me-1 text-primary"></i>Medicines below minimum threshold</span>
            <a href="/Inventory/StockSummary" class="btn btn-xs btn-outline-primary btn-sm py-0 px-2" style="font-size:0.75rem;">View All</a>
        </div>

        <!-- Panel Body: scrollable list -->
        <div id="lowStockList" style="flex:1;overflow-y:auto;padding:1rem 1.25rem;">
            <div class="text-center py-5 text-muted" id="lowStockLoading">
                <div class="spinner-border spinner-border-sm text-primary mb-2" role="status"></div>
                <div class="small">Loading alerts...</div>
            </div>
        </div>

        <!-- Panel Footer -->
        <div style="border-top:1px solid #e2e8f0;padding:0.75rem 1.5rem;background:#f8fafc;flex-shrink:0;">
            <a href="/Purchases/Import" class="btn btn-primary btn-sm w-100 fw-bold">
                <i class="fas fa-file-import me-1"></i> Import Purchase CSV
            </a>
        </div>
    </div>

    <!-- Offline Banner -->
    <div id="offlineBanner" style="display:none;position:fixed;bottom:0;left:0;right:0;z-index:2000;background:linear-gradient(90deg,#dc2626,#b91c1c);color:white;text-align:center;padding:0.6rem 1rem;font-weight:600;font-size:0.88rem;box-shadow:0 -3px 10px rgba(0,0,0,0.2);">
        <i class="fas fa-wifi-slash me-2"></i> No Internet Connection — Changes will not be saved until you're back online.
        <button onclick="document.getElementById('offlineBanner').style.display='none'" class="btn btn-sm ms-3 py-0" style="color:white;border:1px solid rgba(255,255,255,0.5);">Dismiss</button>
    </div>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables/dataTables.bootstrap5.min.js"></script>
    
    <!-- DataTables Export Buttons -->
    <script src="~/lib/datatables/dataTables.buttons.min.js"></script>
    <script src="~/lib/datatables/buttons.bootstrap5.min.js"></script>
    <script src="~/lib/datatables/jszip.min.js"></script>
    <script src="~/lib/datatables/pdfmake.min.js"></script>
    <script src="~/lib/datatables/vfs_fonts.js"></script>
    <script src="~/lib/datatables/buttons.html5.min.js"></script>
    <script src="~/lib/datatables/buttons.print.min.js"></script>
    <script src="~/lib/select2/select2.min.js"></script>
    <script src="~/lib/chartjs/chart.umd.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/quick-add.js" asp-append-version="true"></script>
    <script>
        $("#menu-toggle").click(function(e) {
            e.preventDefault();
            $("#sidebar-wrapper").toggle();
        });

        @if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Doctor"))
        {
            <text>
            function updatePendingPrescriptionCount() {
                $.get('/DoctorPrescription/GetPendingCount', function(res) {
                    if (res && typeof res.count === 'number') {
                        let badge = $('#sidebarQueueBadge');
                        if (res.count > 0) {
                            badge.text(res.count).removeClass('d-none');
                        } else {
                            badge.addClass('d-none');
                        }
                    }
                });
            }
       
            </text>
        }
    </script>
    <!-- Global Loading Overlay -->
    <div id="global-loader" style="display: none;">
        <div class="loader-overlay">
            <div class="loader-content text-center">
                <div class="spinner-border text-primary loader-spinner mb-3" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <h5 class="loader-text text-white fw-bold">Please wait, processing your request...</h5>
            </div>
        </div>
    </div>

    @await Html.PartialAsync("_QuickAddModal")
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
