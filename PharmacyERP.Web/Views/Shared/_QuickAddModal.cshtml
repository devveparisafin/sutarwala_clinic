<div class="modal fade" id="quickAddModal" tabindex="-1" aria-labelledby="quickAddModalLabel" aria-hidden="true" style="z-index: 1060;">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white py-3">
                <h5 class="modal-title font-weight-bold" id="quickAddModalLabel">
                    <i class="fas fa-plus-circle me-2"></i><span id="quickAddTitle">Add New Master</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="quickAddForm" autocomplete="off" onsubmit="event.preventDefault(); saveQuickAdd();">
                    <input type="hidden" id="quickAddType" />
                    
                    <div class="mb-3">
                        <label id="lblQuickAddName" class="form-label fw-bold">Name</label>
                        <input type="text" id="quickAddName" class="form-control form-control-sm" placeholder="Enter name" required />
                        <div class="text-danger small mt-1 d-none" id="valQuickAddName">Name is required.</div>
                    </div>

                    <!-- Optional description for Generic / Category -->
                    <div class="mb-3 d-none" id="divQuickAddDescription">
                        <label class="form-label fw-bold">Description</label>
                        <textarea id="quickAddDescription" class="form-control form-control-sm" rows="2" placeholder="Optional description..."></textarea>
                    </div>

                    <!-- Optional phone/mobile for Manufacturer / Supplier -->
                    <div class="mb-3 d-none" id="divQuickAddPhone">
                        <label class="form-label fw-bold">Phone Number</label>
                        <input type="text" id="quickAddPhone" class="form-control form-control-sm" placeholder="e.g. 9876543210" />
                    </div>

                    <!-- Optional email for Supplier -->
                    <div class="mb-3 d-none" id="divQuickAddEmail">
                        <label class="form-label fw-bold">Email Address</label>
                        <input type="email" id="quickAddEmail" class="form-control form-control-sm" placeholder="e.g. info@supplier.com" />
                    </div>

                    <!-- Generic error alert box -->
                    <div class="alert alert-danger d-none py-2 px-3 small mt-3" id="quickAddErrorBox">
                        <i class="fas fa-exclamation-triangle me-1"></i> <span id="quickAddErrorText">Error message</span>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light py-2">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary btn-sm px-4 fw-bold" id="btnQuickAddSave" onclick="saveQuickAdd()">
                    <span class="spinner-border spinner-border-sm d-none me-1" id="spinnerQuickAdd" role="status" aria-hidden="true"></span>
                    <i class="fas fa-save me-1" id="iconQuickAddSave"></i> Save
                </button>
            </div>
        </div>
    </div>
</div>
