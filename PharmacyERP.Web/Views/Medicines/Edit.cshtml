@model PharmacyERP.Web.Models.ViewModels.MedicineViewModel
@{
    ViewData["Title"] = (Model.Id == null ? "Add Medicine" : "Edit Medicine");
}

<div class="container-fluid px-4">
    <div class="card shadow mb-4 mt-3">
        <div class="card-header py-3 bg-primary text-white">
            <h6 class="m-0 font-weight-bold">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post" enctype="multipart/form-data">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ExistingImagePath" />
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Name" class="form-label font-weight-bold"></label>
                                <input asp-for="Name" class="form-control" placeholder="Enter medicine name" />
                                <span asp-validation-for="Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GenericId" class="form-label font-weight-bold"></label>
                                <select asp-for="GenericId" asp-items="Model.Generics" class="form-control select2">
                                    <option value="">-- Select Generic --</option>
                                </select>
                                <span asp-validation-for="GenericId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="ManufacturerId" class="form-label font-weight-bold"></label>
                                <select asp-for="ManufacturerId" asp-items="Model.Manufacturers" class="form-control select2">
                                    <option value="">-- Select Manufacturer --</option>
                                </select>
                                <span asp-validation-for="ManufacturerId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label font-weight-bold"></label>
                                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control select2">
                                    <option value="">-- Select Category --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="UnitId" class="form-label font-weight-bold"></label>
                                <select asp-for="UnitId" asp-items="Model.Units" class="form-control select2">
                                    <option value="">-- Select Unit --</option>
                                </select>
                                <span asp-validation-for="UnitId" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Barcode" class="form-label font-weight-bold"></label>
                                <input asp-for="Barcode" class="form-control" placeholder="Scan/Enter Barcode" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="HSNCode" class="form-label font-weight-bold"></label>
                                <input asp-for="HSNCode" class="form-control" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="GST" class="form-label font-weight-bold"></label>
                                <div class="input-group">
                                    <input asp-for="GST" class="form-control" />
                                    <span class="input-group-text">%</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RackId" class="form-label font-weight-bold">Select Rack</label>
                                <select asp-for="RackId" asp-items="Model.Racks" class="form-control select2">
                                    <option value="">-- Select Rack --</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="RackLocation" class="form-label font-weight-bold">Specific Location</label>
                                <input asp-for="RackLocation" class="form-control" placeholder="e.g. Shelf 2, Bin A" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LowStockThreshold" class="form-label font-weight-bold"></label>
                                <input asp-for="LowStockThreshold" class="form-control" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label font-weight-bold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        </div>
                        
                        <div class="mb-3">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input asp-for="IsLooseSale" class="form-check-input" type="checkbox" role="switch" id="chkIsLooseSale">
                                        <label asp-for="IsLooseSale" class="form-check-label font-weight-bold">Support Loose Sale?</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check form-switch mt-2">
                                        <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                                        <label asp-for="IsActive" class="form-check-label font-weight-bold">Active Status</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="looseSaleSection" style="display: none;" class="p-3 mb-3 bg-light border rounded">
                            <h6 class="font-weight-bold text-primary mb-3"><i class="fas fa-cog"></i> Loose Sale Configuration</h6>
                            <div class="row">
                                <div class="col-md-4">
                                    <label asp-for="UnitsPerStrip" class="form-label font-weight-bold"></label>
                                    <input asp-for="UnitsPerStrip" class="form-control" type="number" />
                                    <span asp-validation-for="UnitsPerStrip" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="StripName" class="form-label font-weight-bold"></label>
                                    <input asp-for="StripName" class="form-control" placeholder="e.g. Strip" />
                                    <span asp-validation-for="StripName" class="text-danger"></span>
                                </div>
                                <div class="col-md-4">
                                    <label asp-for="LooseUnitName" class="form-label font-weight-bold"></label>
                                    <input asp-for="LooseUnitName" class="form-control" placeholder="e.g. Tablet" />
                                    <span asp-validation-for="LooseUnitName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="mt-2">
                                <small class="text-muted italic"><i class="fas fa-info-circle"></i> Example: 1 <strong>Strip</strong> = 10 <strong>Tablets</strong></small>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4 border-start">
                        <div class="text-center">
                            <label class="form-label font-weight-bold d-block">Medicine Image</label>
                            <div class="mb-3">
                                @if (!string.IsNullOrEmpty(Model.ExistingImagePath))
                                {
                                    <img id="imgPreview" src="~/uploads/medicines/@Model.ExistingImagePath" class="img-thumbnail" style="max-height: 200px;" />
                                }
                                else
                                {
                                    <img id="imgPreview" src="https://via.placeholder.com/200x200?text=No+Image" class="img-thumbnail" style="max-height: 200px;" />
                                }
                            </div>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" onchange="previewImage(this)" />
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5">Save Medicine</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Toggle Loose Sale Section
            $('#chkIsLooseSale').on('change', function() {
                if ($(this).is(':checked')) {
                    $('#looseSaleSection').slideDown();
                } else {
                    $('#looseSaleSection').slideUp();
                }
            });

            // Trigger on load for Edit mode
            if ($('#chkIsLooseSale').is(':checked')) {
                $('#looseSaleSection').show();
            }
        });

        function previewImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    $('#imgPreview').attr('src', e.target.result);
                }
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
