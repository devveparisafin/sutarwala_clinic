@model IEnumerable<PharmacyERP.Web.Models.Entities.DoctorPrescription>
@{
    ViewData["Title"] = "Prescription Queue";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-notes-medical me-2 text-primary"></i>Prescription Sales Queue</h1>
        <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill" id="queueBadge">@Model.Count() Pending</span>
    </div>

    <!-- Active Prescription Cards -->
    <div class="row" id="queueGrid">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4" id="card-@item.Id">
                    <div class="card h-100 border-0 shadow-sm rounded-3 hover-card transition">
                        <div class="card-header bg-white border-0 pt-4 px-4 pb-0 d-flex justify-content-between align-items-start">
                            <div>
                                <span class="badge bg-light text-primary border px-2 py-1 mb-2 small"><i class="fas fa-user-md me-1"></i>Dr. @item.DoctorName</span>
                                <h5 class="card-title fw-bold text-dark mb-0">@item.PatientName</h5>
                                <small class="text-secondary"><i class="fas fa-mobile-alt me-1"></i>@(string.IsNullOrEmpty(item.PatientPhone) ? "No Phone" : item.PatientPhone)</small>
                            </div>
                            <span class="text-muted small">@item.CreatedAt.ToLocalTime().ToString("hh:mm tt")</span>
                        </div>
                        <div class="card-body px-4 py-3">
                            <hr class="my-2 opacity-5" />
                            <h6 class="fw-bold text-secondary small text-uppercase mb-2">Prescribed Medicines</h6>
                            <ul class="list-unstyled mb-0">
                                @foreach (var med in item.Items)
                                {
                                    <li class="mb-2 py-1 border-bottom border-light d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="fw-bold text-dark text-truncate d-inline-block" style="max-width: 180px;" title="@med.MedicineName">@med.MedicineName</span>
                                            <br/><small class="text-muted text-italic">@med.Instructions</small>
                                        </div>
                                        <span class="badge bg-primary rounded-pill text-white fw-bold px-3 py-1">Qty: @med.Qty</span>
                                    </li>
                                }
                            </ul>
                            @if (!string.IsNullOrEmpty(item.Remarks))
                            {
                                <div class="bg-light p-3 rounded-3 mt-3 small text-secondary">
                                    <strong class="d-block mb-1 text-dark"><i class="fas fa-comment-medical me-1"></i>Remarks:</strong>
                                    @item.Remarks
                                </div>
                            }
                        </div>
                        <div class="card-footer bg-white border-0 px-4 pb-4 pt-0">
                            <a href="/Sales/Pos?prescriptionId=@item.Id" class="btn btn-primary w-100 py-3 fw-bold shadow-sm rounded-3">
                                <i class="fas fa-cash-register me-2"></i> Dispense & Bill
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 py-5 text-center text-muted">
                <div class="py-5">
                    <i class="fas fa-check-circle fa-4x text-success opacity-50 mb-3"></i>
                    <h4>Queue is clear!</h4>
                    <p class="small text-secondary">There are no pending doctor prescriptions to dispense at the moment.</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08) !important;
    }
    .transition {
        transition: all 0.25s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        // Simple polling to refresh queue every 30 seconds
        setInterval(function() {
            $.get('/DoctorPrescription/GetPendingCount', function(res) {
                let current = parseInt($('#queueBadge').text()) || 0;
                if (res.count !== current) {
                    location.reload();
                }
            });
        }, 15000);
    </script>
}
