@model PharmacyERP.Web.Models.ViewModels.Reports.SalesReportViewModel
@{
    ViewData["Title"] = "Sales Report";
}

<div class="container-fluid px-4 mt-4">
    <h1 class="h3 mb-4 text-gray-800"><i class="fas fa-chart-bar me-2"></i>Sales Report</h1>

    <!-- Filters -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light">
            <form asp-action="Sales" method="get" class="row g-3 align-items-center">
                <div class="col-auto">
                    <label class="col-form-label fw-bold">Start Date</label>
                </div>
                <div class="col-auto">
                    <input type="date" name="startDate" class="form-control" value="@Model.StartDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <label class="col-form-label fw-bold">End Date</label>
                </div>
                <div class="col-auto">
                    <input type="date" name="endDate" class="form-control" value="@Model.EndDate.ToString("yyyy-MM-dd")" />
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-primary"><i class="fas fa-filter"></i> Filter</button>
                </div>
                <div class="col-auto ms-auto">
                    <h5 class="m-0 font-weight-bold text-success">Total: ₹@Model.GrandTotal.ToString("N2")</h5>
                </div>
            </form>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card shadow-sm mb-4 border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="m-0 font-weight-bold text-primary">Daily Sales Breakdown</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="reportTable" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Invoices</th>
                            <th>SubTotal</th>
                            <th>Tax</th>
                            <th>Discount</th>
                            <th>Total Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DailySales)
                        {
                            <tr>
                                <td class="fw-bold">@item.Date</td>
                                <td>@item.InvoiceCount</td>
                                <td>₹@item.TotalSubTotal.ToString("N2")</td>
                                <td class="text-danger">₹@item.TotalTax.ToString("N2")</td>
                                <td class="text-warning">₹@item.TotalDiscount.ToString("N2")</td>
                                <td class="text-success fw-bold">₹@item.TotalAmount.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light fw-bold">
                        <tr>
                            <td>Total</td>
                            <td>@Model.DailySales.Sum(x => x.InvoiceCount)</td>
                            <td>₹@Model.DailySales.Sum(x => x.TotalSubTotal).ToString("N2")</td>
                            <td>₹@Model.DailySales.Sum(x => x.TotalTax).ToString("N2")</td>
                            <td>₹@Model.DailySales.Sum(x => x.TotalDiscount).ToString("N2")</td>
                            <td>₹@Model.GrandTotal.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#reportTable').DataTable({
                dom: 'Bfrtip',
                buttons: [
                    { extend: 'excelHtml5', className: 'btn btn-success btn-sm', text: '<i class="fas fa-file-excel"></i> Excel' },
                    { extend: 'pdfHtml5', className: 'btn btn-danger btn-sm', text: '<i class="fas fa-file-pdf"></i> PDF' },
                    { extend: 'print', className: 'btn btn-info btn-sm text-white', text: '<i class="fas fa-print"></i> Print' }
                ],
                "order": [[0, "desc"]],
                "pageLength": 25
            });
        });
    </script>
}
