@model PharmacyERP.Web.Models.ViewModels.SupplierViewModel
@{
    ViewData["Title"] = (Model.Id == null ? "Add Supplier" : "Edit Supplier");
}

<div class="container-fluid px-4">
    <div class="card shadow mb-4 mt-3">
        <div class="card-header py-3 bg-primary text-white">
            <h6 class="m-0 font-weight-bold">@ViewData["Title"]</h6>
        </div>
        <div class="card-body">
            <form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post">
                <input type="hidden" asp-for="Id" />
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Name" class="form-label font-weight-bold"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter supplier/company name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="ContactPerson" class="form-label font-weight-bold"></label>
                        <input asp-for="ContactPerson" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="Phone" class="form-label font-weight-bold"></label>
                        <input asp-for="Phone" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="Email" class="form-label font-weight-bold"></label>
                        <input asp-for="Email" class="form-control" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label asp-for="GSTIN" class="form-label font-weight-bold"></label>
                        <input asp-for="GSTIN" class="form-control" placeholder="GST Number" />
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label font-weight-bold"></label>
                    <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="OpeningBalance" class="form-label font-weight-bold"></label>
                        <input asp-for="OpeningBalance" class="form-control" type="number" step="0.01" />
                    </div>
                    <div class="col-md-4 mb-3 pt-4">
                        <div class="form-check form-switch mt-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch">
                            <label asp-for="IsActive" class="form-check-label font-weight-bold">Active Status</label>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary px-5">Save Supplier</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
