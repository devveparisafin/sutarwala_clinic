@model PharmacyERP.Web.Models.ViewModels.SupplierLedgerViewModel
@{
    ViewData["Title"] = "Supplier Ledger";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <h1 class="h3 mb-0 text-gray-800">Supplier Ledger: @Model.SupplierName</h1>
        <div>
            <span class="badge bg-danger p-2 fs-6">Current Balance: ₹@Model.CurrentBalance.ToString("N2")</span>
            <button onclick="window.print()" class="btn btn-secondary ms-2"><i class="fas fa-print"></i> Print</button>
        </div>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">Transaction History</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" width="100%" cellspacing="0">
                    <thead class="table-dark">
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Reference</th>
                            <th class="text-end">Debit (Paid)</th>
                            <th class="text-end">Credit (Purchase)</th>
                            <th class="text-end">Running Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td>@entry.Date.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@entry.Description</td>
                                <td>@entry.Reference</td>
                                <td class="text-end text-success">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "-")</td>
                                <td class="text-end text-danger">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "-")</td>
                                <td class="text-end font-weight-bold">@entry.Balance.ToString("N2")</td>
                            </tr>
                        }
                        @if (!Model.Entries.Any())
                        {
                            <tr><td colspan="6" class="text-center">No transactions found.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
