@model IEnumerable<PharmacyERP.Web.Models.Entities.MedicineBatch>
@{
    ViewData["Title"] = "Expiry Alerts";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-exclamation-triangle text-warning me-2"></i>Expiry Alerts</h1>
        <div class="text-muted small">Showing batches expiring within 90 days</div>
    </div>

    <div class="card shadow mb-4 border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="expiryTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Medicine ID</th>
                            <th>Batch No</th>
                            <th>Expiry Date</th>
                            <th>Current Qty</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var daysLeft = (item.ExpiryDate - DateTime.UtcNow).Days;
                            var statusClass = daysLeft < 0 ? "bg-danger" : (daysLeft < 30 ? "bg-warning text-dark" : "bg-info text-white");
                            var statusText = daysLeft < 0 ? "Expired" : (daysLeft < 30 ? $"Expiring in {daysLeft} days" : $"Expiring in {daysLeft} days");

                            <tr>
                                <td>@item.MedicineId</td>
                                <td><span class="badge bg-secondary">@item.BatchNo</span></td>
                                <td class="@(daysLeft < 0 ? "text-danger fw-bold" : "")">@item.ExpiryDate.ToShortDateString()</td>
                                <td>@item.CurrentQty</td>
                                <td><span class="badge @statusClass">@statusText</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expiryTable').DataTable({
                "order": [[2, "asc"]]
            });
        });
    </script>
}
