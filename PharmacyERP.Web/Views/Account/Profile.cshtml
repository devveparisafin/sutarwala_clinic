@model PharmacyERP.Web.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "User Profile";
}

<div class="container py-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card text-center shadow">
                <div class="card-body">
                    <div class="mb-3">
                        <i class="fas fa-user-circle fa-7x text-primary"></i>
                    </div>
                    <h4>@Model.FullName</h4>
                    <p class="text-muted">@Model.RoleName</p>
                    <hr />
                    <div class="text-start">
                        <p><strong>Username:</strong> @Model.Username</p>
                        <p><strong>Email:</strong> @Model.Email</p>
                        <p><strong>Last Login:</strong> @(Model.LastLogin?.ToString("g") ?? "Never")</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Settings</h5>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6>Change Password</h6>
                                <p class="text-muted small mb-0">Update your account password regularly for security.</p>
                            </div>
                            <a asp-action="ChangePassword" class="btn btn-outline-primary btn-sm">Change</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <script>
        $(document).ready(function() {
            notify.success('@TempData["SuccessMessage"]');
        });
    </script>
}
