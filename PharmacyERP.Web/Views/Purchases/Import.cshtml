@model PharmacyERP.Web.Models.ViewModels.PurchaseEntryViewModel
@{
    ViewData["Title"] = "Import Purchases";
}

<style>
    .import-wizard-step {
        display: none;
    }
    .import-wizard-step.active {
        display: block;
    }

    /* Steps indicator styling */
    .steps-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        position: relative;
        background: white;
        padding: 1.5rem;
        border-radius: var(--border-radius);
        box-shadow: var(--card-shadow);
    }
    .steps-container::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 4px;
        background: #e2e8f0;
        z-index: 1;
        transform: translateY(-50%);
    }
    .step-progress-bar {
        position: absolute;
        top: 50%;
        left: 0;
        width: 0%;
        height: 4px;
        background: var(--primary-color);
        z-index: 2;
        transform: translateY(-50%);
        transition: width 0.4s ease;
    }
    .step-node {
        position: relative;
        z-index: 3;
        background: white;
        border: 3px solid #cbd5e1;
        border-radius: 50%;
        width: 45px;
        height: 45px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        color: #64748b;
        transition: all 0.4s ease;
        box-shadow: 0 0 0 5px white;
    }
    .step-node.active {
        border-color: var(--primary-color);
        color: var(--primary-color);
        box-shadow: 0 0 15px rgba(30, 126, 78, 0.2), 0 0 0 5px white;
    }
    .step-node.completed {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: white;
    }
    .step-label {
        position: absolute;
        top: 55px;
        width: 150px;
        text-align: center;
        font-size: 0.8rem;
        font-weight: 600;
        color: #64748b;
        left: 50%;
        transform: translateX(-50%);
    }
    .step-node.active .step-label {
        color: var(--primary-color);
    }
    .step-node.completed .step-label {
        color: #1e293b;
    }

    /* Upload zone styling */
    .upload-zone {
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 3rem 2rem;
        text-align: center;
        background: #f8fafc;
        cursor: pointer;
        transition: all 0.2s ease;
        position: relative;
    }
    .upload-zone:hover, .upload-zone.dragover {
        border-color: var(--primary-color);
        background: #ecfdf5;
    }
    .upload-icon {
        font-size: 3rem;
        color: #94a3b8;
        margin-bottom: 1rem;
        transition: color 0.2s ease;
    }
    .upload-zone:hover .upload-icon {
        color: var(--primary-color);
    }

    /* Missing medicines card styling */
    .missing-med-card {
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: white;
        box-shadow: var(--card-shadow);
        transition: all 0.3s ease;
        margin-bottom: 1.5rem;
    }
    .missing-med-card.registered {
        border-color: #10b981;
        background-color: #f0fdf4;
    }
    .missing-med-header {
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 0.75rem 1rem;
        font-weight: 700;
        color: #1e293b;
        border-top-left-radius: 8px;
        border-top-right-radius: 8px;
    }
    .missing-med-card.registered .missing-med-header {
        background: #d1fae5;
        color: #065f46;
        border-bottom-color: #a7f3d0;
    }
    .missing-med-card.mapped {
        border-color: #3b82f6;
        background-color: #eff6ff;
    }
    .missing-med-card.mapped .missing-med-header {
        background: #dbeafe;
        color: #1e40af;
        border-bottom-color: #93c5fd;
    }
    .med-option-toggle .btn-check:checked + .btn-outline-success {
        background-color: #10b981;
        color: white;
    }
    .med-option-toggle .btn-check:checked + .btn-outline-primary {
        background-color: #3b82f6;
        color: white;
    }
    .med-panel {
        transition: all 0.2s ease;
    }
    .med-panel.d-none {
        display: none !important;
    }
    .map-search-hint {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 6px;
        padding: 0.5rem 0.75rem;
        font-size: 0.8rem;
        color: #1e40af;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-file-import me-2 text-success"></i>Import Purchase Invoice</h1>
        <a asp-action="Index" class="btn btn-outline-secondary shadow-sm">
            <i class="fas fa-arrow-left fa-sm me-1"></i> Back to History
        </a>
    </div>

    <!-- Step Indicator Progress Bar -->
    <div class="steps-container">
        <div class="step-progress-bar" id="stepProgressBar"></div>
        <div class="step-node active" id="stepNode1">
            1 <span class="step-label">Upload & Setup</span>
        </div>
        <div class="step-node" id="stepNode2">
            2 <span class="step-label">Missing Medicines</span>
        </div>
        <div class="step-node" id="stepNode3">
            3 <span class="step-label">Verify & Confirm</span>
        </div>
    </div>

    <!-- Wizard Steps Form -->
    <form id="importWizardForm">
        <!-- STEP 1: UPLOAD & SETUP -->
        <div class="card shadow border-0 import-wizard-step active" id="step1Content">
            <div class="card-header py-3 bg-white border-0">
                <h5 class="m-0 font-weight-bold text-dark"><i class="fas fa-cog me-2"></i>Step 1: Setup Invoice & Upload CSV</h5>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-4">
                        <label for="ImportSupplierId" class="form-label">Supplier <span class="text-danger">*</span></label>
                        <select id="ImportSupplierId" class="form-control select2">
                            <option value="">-- Select Supplier --</option>
                            @foreach (var item in ViewBag.Suppliers)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="ImportInvoiceNo" class="form-label">Invoice Number <span class="text-danger">*</span></label>
                        <input id="ImportInvoiceNo" class="form-control" placeholder="e.g. INV-998822" />
                    </div>
                    <div class="col-md-2">
                        <label for="ImportPurchaseDate" class="form-label">Purchase Date <span class="text-danger">*</span></label>
                        <input id="ImportPurchaseDate" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3">
                        <label for="ImportPaymentMode" class="form-label">Payment Mode</label>
                        <select id="ImportPaymentMode" class="form-control">
                            <option value="Credit">Credit</option>
                            <option value="Cash">Cash</option>
                            <option value="Online">Online</option>
                        </select>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="ImportRemarks" class="form-label">Internal Remarks</label>
                    <textarea id="ImportRemarks" class="form-control" rows="2" placeholder="Optional notes..."></textarea>
                </div>

                <hr class="my-4" />

                <div class="row align-items-center">
                    <div class="col-lg-8 mb-3 mb-lg-0">
                        <div class="upload-zone" id="uploadZone">
                            <input type="file" id="csvFileInput" accept=".csv" class="d-none" />
                            <i class="fas fa-cloud-upload-alt upload-icon"></i>
                            <h5 class="fw-bold">Drag and drop your CSV invoice here</h5>
                            <p class="text-muted small">Or click to select a file from your computer</p>
                            <div class="mt-2 fw-bold text-success d-none" id="selectedFileInfo">
                                <i class="fas fa-file-csv me-1"></i> <span id="selectedFileName"></span>
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-4">
                        <div class="card bg-light border-0">
                            <div class="card-body p-3">
                                <h6 class="fw-bold text-primary"><i class="fas fa-info-circle me-1"></i>Importing Guidelines</h6>
                                <p class="small text-muted mb-2">Please make sure your CSV contains the following column headers exactly:</p>
                                <ul class="small text-muted mb-3 ps-3">
                                    <li><code>MedicineName</code>, <code>BatchNo</code></li>
                                    <li><code>ExpiryDate</code> (MM/YY or YYYY-MM-DD)</li>
                                    <li><code>Qty</code>, <code>FreeQty</code>, <code>UnitsPerStrip</code></li>
                                    <li><code>PurchaseRate</code>, <code>SaleRate</code></li>
                                    <li><code>MRP</code>, <code>GST</code></li>
                                </ul>
                                <a asp-action="DownloadSampleCsv" class="btn btn-sm btn-outline-primary w-100 fw-bold">
                                    <i class="fas fa-download me-1"></i> Download Sample CSV
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-3 text-end">
                <button type="button" class="btn btn-primary px-4 shadow fw-bold" onclick="processUploadStep()">
                    Next: Check Medicines <i class="fas fa-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- STEP 2: REGISTER MISSING MEDICINES -->
        <div class="card shadow border-0 import-wizard-step" id="step2Content">
            <div class="card-header py-3 bg-white border-0 d-flex justify-content-between align-items-center">
                <h5 class="m-0 font-weight-bold text-dark"><i class="fas fa-pills me-2 text-warning"></i>Step 2: Register Unrecognized Medicines</h5>
                <span class="badge bg-warning text-dark px-3 py-2 fw-bold rounded-pill" id="missingMedsBadge">0 Missing Medicines</span>
            </div>
            <div class="card-body">
                <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="fas fa-exclamation-triangle fa-2x me-3 text-warning"></i>
                    <div>
                        <h6 class="fw-bold mb-1">Unregistered Medicines Detected</h6>
                        The following medicines in your CSV are not registered in the system. You must quickly register them below using category, manufacturer, generic and unit details before moving to the next step.
                    </div>
                </div>

                <!-- Missing Medicines Grid -->
                <div class="row" id="missingMedicinesList">
                    <!-- Dynamic missing medicine cards will be injected here -->
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary px-4 fw-bold" onclick="prevStep(1)">
                    <i class="fas fa-arrow-left me-1"></i> Back to Upload
                </button>
                <button type="button" class="btn btn-primary px-4 shadow fw-bold" id="btnNextToVerify" onclick="proceedToVerifyStep()">
                    Next: Verify Purchases <i class="fas fa-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- STEP 3: VERIFICATION & CONFIRM -->
        <div class="card shadow border-0 import-wizard-step" id="step3Content">
            <div class="card-header py-3 bg-white border-0">
                <h5 class="m-0 font-weight-bold text-dark"><i class="fas fa-file-contract me-2 text-success"></i>Step 3: Verification & Calculations</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-success border-0 shadow-sm d-flex align-items-center mb-4">
                    <i class="fas fa-check-circle fa-2x me-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-1">All Medicines Validated!</h6>
                        All medicines have been successfully verified/registered. Please review the parsed invoice items and totals summary below before starting the final import.
                    </div>
                </div>

                <div class="table-responsive mb-4" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-bordered table-hover align-middle table-sm">
                        <thead class="table-dark sticky-top">
                            <tr class="small text-center">
                                <th>Medicine Name</th>
                                <th>Batch No</th>
                                <th>Expiry</th>
                                <th>Packing</th>
                                <th>Qty</th>
                                <th>Free</th>
                                <th>Rate/Strip</th>
                                <th>Disc%</th>
                                <th>MRP</th>
                                <th>S.Rate</th>
                                <th>GST%</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody id="verificationTableBody">
                            <!-- Dynamic parsed rows injected here -->
                        </tbody>
                    </table>
                </div>

                <div class="row">
                    <div class="col-md-7 mb-3">
                        <div class="card bg-light border-0">
                            <div class="card-body p-4">
                                <h6 class="fw-bold text-dark mb-3"><i class="fas fa-file-invoice-dollar me-2 text-success"></i>Invoice Summary Details</h6>
                                <div class="row text-muted small">
                                    <div class="col-sm-6 mb-2"><strong>Supplier:</strong> <span id="summarySupplierName">N/A</span></div>
                                    <div class="col-sm-6 mb-2"><strong>Invoice No:</strong> <span id="summaryInvoiceNo">N/A</span></div>
                                    <div class="col-sm-6 mb-2"><strong>Date:</strong> <span id="summaryPurchaseDate">N/A</span></div>
                                    <div class="col-sm-6 mb-2"><strong>Payment Mode:</strong> <span id="summaryPaymentMode">N/A</span></div>
                                </div>
                                <div class="mt-3 text-muted small">
                                    <strong>Remarks:</strong> <span id="summaryRemarks">N/A</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-check mt-4 p-3 bg-light border rounded d-flex align-items-center">
                            <input class="form-check-input ms-1 me-3" type="checkbox" id="chkVerifyConfirm" style="transform: scale(1.3); cursor: pointer;" />
                            <label class="form-check-label fw-bold text-dark" for="chkVerifyConfirm" style="cursor: pointer;">
                                I verify that all parsed items, quantities, and pricing are matching the supplier's physical invoice.
                            </label>
                        </div>
                    </div>
                    <div class="col-md-5">
                        <div class="card bg-dark text-white border-0">
                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between mb-3">
                                    <span class="text-white-50">Sub Total:</span>
                                    <h5 class="fw-bold m-0" id="verifySubTotal">₹0.00</h5>
                                </div>
                                <div class="d-flex justify-content-between mb-3 text-success">
                                    <span>Discount (-):</span>
                                    <h5 class="fw-bold m-0" id="verifyDiscount">₹0.00</h5>
                                </div>
                                <div class="d-flex justify-content-between mb-3 text-warning">
                                    <span>GST Tax (+):</span>
                                    <h5 class="fw-bold m-0" id="verifyGST">₹0.00</h5>
                                </div>
                                <hr class="border-secondary my-3" />
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5 class="fw-bold text-success m-0">Net Payable:</h5>
                                    <h3 class="fw-extrabold m-0 text-success" id="verifyGrandTotal" style="font-weight: 850;">₹0.00</h3>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-footer bg-white border-0 py-3 d-flex justify-content-between">
                <button type="button" class="btn btn-outline-secondary px-4 fw-bold" onclick="prevStep(2)">
                    <i class="fas fa-arrow-left me-1"></i> Back to Medicines
                </button>
                <button type="button" class="btn btn-success btn-lg px-5 shadow fw-bold" onclick="startFinalImport()">
                    <i class="fas fa-file-import me-1"></i> Confirm & Start Import
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function generateGuid() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }
        let transactionGuid = generateGuid();

        let parsedItems = [];
        let missingMedicines = [];
        let masterData = null;
        let selectedFile = null;

        $(document).ready(function() {
            $('.select2').select2({ theme: 'bootstrap-5' });

            // Fetch Master Data for Step 2 Dropdowns
            $.getJSON('/Purchases/GetImportMasterData', function(data) {
                masterData = data;
            });

            // Drag and drop zone handling
            const zone = $('#uploadZone');
            const fileInput = $('#csvFileInput');

            zone.on('click', () => fileInput.click());

            zone.on('dragover', (e) => {
                e.preventDefault();
                zone.addClass('dragover');
            });

            zone.on('dragleave', () => {
                zone.removeClass('dragover');
            });

            zone.on('drop', (e) => {
                e.preventDefault();
                zone.removeClass('dragover');
                const files = e.originalEvent.dataTransfer.files;
                if (files.length > 0 && files[0].name.endsWith('.csv')) {
                    handleFileSelection(files[0]);
                } else {
                    toastr.error("Please upload a valid CSV file.");
                }
            });

            fileInput.on('change', (e) => {
                if (e.target.files.length > 0) {
                    handleFileSelection(e.target.files[0]);
                }
            });
        });

        function handleFileSelection(file) {
            selectedFile = file;
            $('#selectedFileName').text(file.name);
            $('#selectedFileInfo').removeClass('d-none');
            toastr.success(`CSV file selected: ${file.name}`);
        }

        function changeStep(stepNum) {
            // Manage Step Indicator
            $('.step-node').removeClass('active completed');
            for (let i = 1; i <= 3; i++) {
                const node = $(`#stepNode${i}`);
                if (i < stepNum) {
                    node.addClass('completed');
                } else if (i === stepNum) {
                    node.addClass('active');
                }
            }
            const progressPercent = (stepNum - 1) * 50;
            $('#stepProgressBar').css('width', `${progressPercent}%`);

            // Manage content pages
            $('.import-wizard-step').removeClass('active');
            $(`#step${stepNum}Content`).addClass('active');

            // Scroll to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function prevStep(stepNum) {
            changeStep(stepNum);
        }

        function processUploadStep() {
            const supplierId = $('#ImportSupplierId').val();
            const invoiceNo = $('#ImportInvoiceNo').val();
            const purchaseDate = $('#ImportPurchaseDate').val();

            if (!supplierId) { toastr.error("Supplier is required."); return; }
            if (!invoiceNo) { toastr.error("Invoice number is required."); return; }
            if (!purchaseDate) { toastr.error("Purchase date is required."); return; }
            if (!selectedFile) { toastr.error("Please upload a CSV file first."); return; }

            // Display global loading spinner
            $('#global-loader').show();

            const formData = new FormData();
            formData.append("file", selectedFile);

            $.ajax({
                url: '/Purchases/ParseImport',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(res) {
                    $('#global-loader').hide();
                    if (res.success) {
                        parsedItems = res.items;
                        missingMedicines = res.missingMedicines;

                        if (missingMedicines.length > 0) {
                            renderMissingMedicinesStep();
                            changeStep(2);
                        } else {
                            renderVerificationStep();
                            changeStep(3);
                        }
                    } else {
                        toastr.error(res.message || "An error occurred while parsing CSV.");
                    }
                },
                error: function() {
                    $('#global-loader').hide();
                    toastr.error("An error occurred while communicating with the server.");
                }
            });
        }

        function renderMissingMedicinesStep() {
            const container = $('#missingMedicinesList');
            container.empty();

            $('#missingMedsBadge').text(`${missingMedicines.length} Missing Medicine(s)`);
            $('#btnNextToVerify').attr('disabled', true);

            missingMedicines.forEach((medName, idx) => {
                // Find unitsPerStrip and GST prefilled from CSV for this missing medicine
                const matchingRow = parsedItems.find(x => x.medicineName === medName) || {};
                const gstVal = matchingRow.gst || 0;
                const unitsVal = matchingRow.unitsPerStrip || 1;

                // Create options for dropdowns
                let catOptions = '<option value="">-- Category --</option>';
                masterData.categories.forEach(x => catOptions += `<option value="${x.id}">${x.name}</option>`);

                let manOptions = '<option value="">-- Manufacturer --</option>';
                masterData.manufacturers.forEach(x => manOptions += `<option value="${x.id}">${x.name}</option>`);

                let unitOptions = '<option value="">-- Unit --</option>';
                masterData.units.forEach(x => unitOptions += `<option value="${x.id}">${x.name}</option>`);

                let genOptions = '<option value="">-- Generic Name --</option>';
                masterData.generics.forEach(x => genOptions += `<option value="${x.id}">${x.name}</option>`);

                let rackOptions = '<option value="">-- Rack Location --</option>';
                masterData.racks.forEach(x => rackOptions += `<option value="${x.id}">${x.name}</option>`);

                const cardHtml = `
                    <div class="col-lg-6 mb-3" id="missingMedCard_${idx}">
                        <div class="missing-med-card h-100">
                            <div class="missing-med-header d-flex justify-content-between align-items-center">
                                <span><i class="fas fa-pills me-2 text-warning"></i>${medName}</span>
                                <span class="badge bg-danger rounded-pill px-2 py-1 small status-badge">Unregistered</span>
                            </div>

                            <!-- Option Toggle -->
                            <div class="p-3 pb-0">
                                <div class="d-flex gap-2 med-option-toggle" id="medToggle_${idx}">
                                    <input class="btn-check" type="radio" name="medOption_${idx}" id="optCreate_${idx}" autocomplete="off" checked onchange="toggleMedOption(${idx}, 'create')">
                                    <label class="btn btn-outline-success btn-sm fw-bold flex-fill" for="optCreate_${idx}">
                                        <i class="fas fa-plus-circle me-1"></i> Create New
                                    </label>
                                    <input class="btn-check" type="radio" name="medOption_${idx}" id="optMap_${idx}" autocomplete="off" onchange="toggleMedOption(${idx}, 'map')">
                                    <label class="btn btn-outline-primary btn-sm fw-bold flex-fill" for="optMap_${idx}">
                                        <i class="fas fa-link me-1"></i> Map to Existing
                                    </label>
                                </div>
                            </div>

                            <!-- Panel: Create New -->
                            <div class="card-body p-3 med-panel" id="panelCreate_${idx}">
                                <div class="row g-2">
                                    <div class="col-sm-6">
                                        <select class="form-select form-select-sm generic-sel select2-quick" required>
                                            ${genOptions}
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <select class="form-select form-select-sm category-sel select2-quick" required>
                                            ${catOptions}
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <select class="form-select form-select-sm manufacturer-sel select2-quick" required>
                                            ${manOptions}
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <select class="form-select form-select-sm unit-sel select2-quick" required>
                                            ${unitOptions}
                                        </select>
                                    </div>
                                    <div class="col-sm-6">
                                        <select class="form-select form-select-sm rack-sel select2-quick">
                                            ${rackOptions}
                                        </select>
                                    </div>
                                    <div class="col-sm-3">
                                        <input type="number" class="form-control form-control-sm gst-input text-center" placeholder="GST%" value="${gstVal}" title="GST Percentage" />
                                    </div>
                                    <div class="col-sm-3">
                                        <input type="number" class="form-control form-control-sm units-input text-center" placeholder="Packing" value="${unitsVal}" title="Units Per Strip" />
                                    </div>
                                </div>
                            </div>

                            <!-- Panel: Map to Existing -->
                            <div class="card-body p-3 med-panel d-none" id="panelMap_${idx}">
                                <div class="map-search-hint mb-3">
                                    <i class="fas fa-info-circle me-1"></i>
                                    Search by medicine name, generic name, or brand. The CSV item will be linked to the selected existing medicine.
                                </div>
                                <select class="form-select form-select-sm map-med-sel" id="mapMedSel_${idx}" style="width:100%">
                                    <option value="">Search and select existing medicine...</option>
                                </select>
                                <div class="mt-2 text-muted small" id="mapMedInfo_${idx}"></div>
                            </div>

                            <div class="card-footer bg-light p-2 text-end border-top-0" id="cardFooter_${idx}">
                                <!-- Create New footer -->
                                <div id="footerCreate_${idx}">
                                    <button type="button" class="btn btn-sm btn-success fw-bold px-3 btn-register-quick" onclick="registerMissingMedicine(${idx}, '${escape(medName)}')">
                                        <i class="fas fa-plus-circle me-1"></i> Register Medicine
                                    </button>
                                </div>
                                <!-- Map to Existing footer -->
                                <div id="footerMap_${idx}" class="d-none">
                                    <button type="button" class="btn btn-sm btn-primary fw-bold px-3" onclick="mapMissingMedicine(${idx}, '${escape(medName)}')">
                                        <i class="fas fa-link me-1"></i> Confirm Mapping
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                container.append(cardHtml);
            });

            // Initialize select2 on the newly generated select fields
            $('.select2-quick').select2({ theme: 'bootstrap-5', width: '100%' });

            // Initialize the Map to Existing select2 AJAX searches
            missingMedicines.forEach((medName, idx) => {
                $(`#mapMedSel_${idx}`).select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: 'Search existing medicine...',
                    minimumInputLength: 1,
                    ajax: {
                        url: '/Purchases/SearchMedicine',
                        dataType: 'json',
                        delay: 250,
                        data: params => ({ term: params.term }),
                        processResults: data => ({
                            results: $.map(data, item => ({
                                id: item.id,
                                text: item.text,
                                gst: item.gst,
                                unitsPerStrip: item.unitsPerStrip
                            }))
                        }),
                        cache: true
                    }
                }).on('select2:select', function(e) {
                    const d = e.params.data;
                    $(`#mapMedInfo_${idx}`).html(
                        `<span class="badge bg-primary me-1">${d.text}</span>
                         <span class="text-muted">GST: <strong>${d.gst || 0}%</strong> &nbsp; Packing: <strong>${d.unitsPerStrip || 1}</strong></span>`
                    );
                });
            });
        }

        function toggleMedOption(idx, option) {
            if (option === 'create') {
                $(`#panelCreate_${idx}`).removeClass('d-none');
                $(`#panelMap_${idx}`).addClass('d-none');
                $(`#footerCreate_${idx}`).removeClass('d-none');
                $(`#footerMap_${idx}`).addClass('d-none');
            } else {
                $(`#panelCreate_${idx}`).addClass('d-none');
                $(`#panelMap_${idx}`).removeClass('d-none');
                $(`#footerCreate_${idx}`).addClass('d-none');
                $(`#footerMap_${idx}`).removeClass('d-none');
            }
        }

        function mapMissingMedicine(idx, escapedName) {
            const medName = unescape(escapedName);
            const card = $(`#missingMedCard_${idx}`);
            const selected = $(`#mapMedSel_${idx}`).select2('data');

            if (!selected || !selected.length || !selected[0].id) {
                toastr.error("Please search and select an existing medicine to map to.");
                return;
            }

            const mappedMed = selected[0];

            // Update parsedItems in memory to link to the selected database medicine
            parsedItems.forEach(item => {
                if (item.medicineName === medName) {
                    item.medicineId = mappedMed.id;
                    item.exists = true;
                    item.gst = mappedMed.gst || item.gst;
                    item.unitsPerStrip = mappedMed.unitsPerStrip || item.unitsPerStrip;
                    // Keep original prices from CSV, just link the ID
                }
            });

            toastr.success(`"${medName}" mapped to "${mappedMed.text}" successfully!`);

            // Mark card as mapped in UI
            card.find('.missing-med-card').addClass('mapped');
            card.find('.status-badge').removeClass('bg-danger').addClass('bg-primary').text('Mapped');
            card.find(`#panelMap_${idx}`).html(`
                <div class="d-flex align-items-center gap-2 py-1">
                    <i class="fas fa-check-circle text-primary fa-lg"></i>
                    <div>
                        <div class="fw-bold text-primary">${mappedMed.text}</div>
                        <div class="text-muted small">GST: ${mappedMed.gst || 0}% &nbsp;|&nbsp; Packing: ${mappedMed.unitsPerStrip || 1}</div>
                    </div>
                </div>
            `);
            card.find(`#footerMap_${idx}`).html(`<span class="text-primary fw-bold p-1"><i class="fas fa-link me-1"></i> Mapped!</span>`);
            card.find('.med-option-toggle').hide();

            // Remove from missingMedicines list
            missingMedicines = missingMedicines.filter(x => x !== medName);
            $('#missingMedsBadge').text(`${missingMedicines.length} Missing Medicine(s)`);

            if (missingMedicines.length === 0) {
                $('#btnNextToVerify').removeAttr('disabled').addClass('btn-success');
                toastr.success("All medicines resolved! You can now proceed.");
            }
        }

        function registerMissingMedicine(idx, escapedName) {
            const medName = unescape(escapedName);
            const card = $(`#missingMedCard_${idx}`);

            const model = {
                Name: medName,
                GenericId: card.find('.generic-sel').val(),
                ManufacturerId: card.find('.manufacturer-sel').val(),
                CategoryId: card.find('.category-sel').val(),
                UnitId: card.find('.unit-sel').val(),
                RackId: card.find('.rack-sel').val() || null,
                GST: parseFloat(card.find('.gst-input').val()) || 0,
                UnitsPerStrip: parseInt(card.find('.units-input').val()) || 1
            };

            if (!model.GenericId) { toastr.error("Generic Name is required."); return; }
            if (!model.CategoryId) { toastr.error("Category is required."); return; }
            if (!model.ManufacturerId) { toastr.error("Manufacturer is required."); return; }
            if (!model.UnitId) { toastr.error("Unit is required."); return; }
            if (model.UnitsPerStrip < 1) { toastr.error("Units per strip must be at least 1."); return; }

            $('#global-loader').show();

            $.ajax({
                url: '/Purchases/QuickCreateMedicine',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function(res) {
                    $('#global-loader').hide();
                    if (res.success) {
                        toastr.success(`Registered: ${medName}`);

                        // Mark card as registered in UI
                        card.find('.missing-med-card').addClass('registered');
                        card.find('.status-badge').removeClass('bg-danger').addClass('bg-success').text('Registered');
                        card.find('.card-body select, card.find(".card-body input, card.find(".btn-register-quick")').attr('disabled', true);
                        card.find('.btn-register-quick').replaceWith(`
                            <span class="text-success fw-bold p-1"><i class="fas fa-check-circle me-1"></i> Registered!</span>
                        `);

                        // Update parsedItems matching this medicine name
                        parsedItems.forEach(item => {
                            if (item.medicineName === medName) {
                                item.medicineId = res.medicineId;
                                item.exists = true;
                                item.gst = model.GST;
                                item.unitsPerStrip = model.UnitsPerStrip;
                            }
                        });

                        // Filter out from missingMedicines list
                        missingMedicines = missingMedicines.filter(x => x !== medName);
                        $('#missingMedsBadge').text(`${missingMedicines.length} Missing Medicine(s)`);

                        if (missingMedicines.length === 0) {
                            $('#btnNextToVerify').removeAttr('disabled').addClass('btn-success');
                            toastr.success("All missing medicines registered! You can now proceed.");
                        }
                    } else {
                        toastr.error(res.message || "Failed to register medicine.");
                    }
                },
                error: function() {
                    $('#global-loader').hide();
                    toastr.error("An error occurred during quick medicine registration.");
                }
            });
        }

        function proceedToVerifyStep() {
            if (missingMedicines.length > 0) {
                toastr.error("Please register all unrecognized medicines before proceeding.");
                return;
            }
            renderVerificationStep();
            changeStep(3);
        }

        function renderVerificationStep() {
            const body = $('#verificationTableBody');
            body.empty();

            $('#summarySupplierName').text($('#ImportSupplierId option:selected').text());
            $('#summaryInvoiceNo').text($('#ImportInvoiceNo').val());
            $('#summaryPurchaseDate').text($('#ImportPurchaseDate').val());
            $('#summaryPaymentMode').text($('#ImportPaymentMode').val());
            $('#summaryRemarks').text($('#ImportRemarks').val() || 'None');

            let subTotal = 0;
            let discountTotal = 0;
            let gstTotal = 0;

            parsedItems.forEach((item, index) => {
                const totalItemPrice = item.qty * item.purchaseRate;
                const discountAmt = (totalItemPrice * (item.discount || 0)) / 100;
                const taxableAmount = totalItemPrice - discountAmt;
                const itemGstAmount = (taxableAmount * item.gst) / 100;
                const rowTotalPrice = taxableAmount + itemGstAmount;

                subTotal += totalItemPrice;
                discountTotal += discountAmt;
                gstTotal += itemGstAmount;

                const rowHtml = `
                    <tr class="small text-center align-middle" data-index="${index}">
                        <td class="text-start fw-bold text-primary">${item.medicineName}</td>
                        <td class="text-uppercase">${item.batchNo}</td>
                        <td>${item.expiryRaw}</td>
                        <td style="width: 80px;"><input type="number" class="form-control form-control-sm text-center edit-units" value="${item.unitsPerStrip}" min="1"></td>
                        <td style="width: 80px;"><input type="number" class="form-control form-control-sm text-center edit-qty" value="${item.qty}" min="0"></td>
                        <td style="width: 80px;"><input type="number" class="form-control form-control-sm text-center edit-free" value="${item.freeQty}" min="0"></td>
                        <td style="width: 90px;"><input type="number" step="0.01" class="form-control form-control-sm text-end edit-prate" value="${item.purchaseRate.toFixed(2)}" min="0"></td>
                        <td style="width: 80px;"><input type="number" step="0.01" class="form-control form-control-sm text-end edit-disc" value="${(item.discount || 0).toFixed(2)}" min="0"></td>
                        <td style="width: 90px;"><input type="number" step="0.01" class="form-control form-control-sm text-end edit-mrp" value="${item.mrp.toFixed(2)}" min="0"></td>
                        <td style="width: 90px;"><input type="number" step="0.01" class="form-control form-control-sm text-end edit-srate" value="${item.saleRate.toFixed(2)}" min="0"></td>
                        <td style="width: 80px;"><input type="number" step="0.01" class="form-control form-control-sm text-center edit-gst" value="${item.gst}" min="0"></td>
                        <td class="text-end fw-bold row-total">₹${rowTotalPrice.toFixed(2)}</td>
                    </tr>
                `;
                body.append(rowHtml);
            });

            bindGridEvents();

            const grandTotal = subTotal - discountTotal + gstTotal;

            $('#verifySubTotal').text(`₹${subTotal.toFixed(2)}`);
            $('#verifyDiscount').text(`₹${discountTotal.toFixed(2)}`);
            $('#verifyGST').text(`₹${gstTotal.toFixed(2)}`);
            $('#verifyGrandTotal').text(`₹${grandTotal.toFixed(2)}`);

            $('#chkVerifyConfirm').prop('checked', false);
        }

        function bindGridEvents() {
            $('#verificationTableBody input').on('change keyup', function() {
                const tr = $(this).closest('tr');
                const index = tr.data('index');
                const item = parsedItems[index];

                item.unitsPerStrip = parseInt(tr.find('.edit-units').val()) || 1;
                item.qty = parseInt(tr.find('.edit-qty').val()) || 0;
                item.freeQty = parseInt(tr.find('.edit-free').val()) || 0;
                item.purchaseRate = parseFloat(tr.find('.edit-prate').val()) || 0;
                item.discount = parseFloat(tr.find('.edit-disc').val()) || 0;
                item.mrp = parseFloat(tr.find('.edit-mrp').val()) || 0;
                item.saleRate = parseFloat(tr.find('.edit-srate').val()) || 0;
                item.gst = parseFloat(tr.find('.edit-gst').val()) || 0;

                const totalItemPrice = item.qty * item.purchaseRate;
                const discountAmt = (totalItemPrice * (item.discount || 0)) / 100;
                const taxableAmount = totalItemPrice - discountAmt;
                const itemGstAmount = (taxableAmount * item.gst) / 100;
                const rowTotalPrice = taxableAmount + itemGstAmount;

                tr.find('.row-total').text('₹' + rowTotalPrice.toFixed(2));

                // Recalculate grand totals
                let subTotal = 0;
                let discountTotal = 0;
                let gstTotal = 0;
                parsedItems.forEach(i => {
                    const tPrice = i.qty * i.purchaseRate;
                    const tDisc = (tPrice * (i.discount || 0)) / 100;
                    const tTaxable = tPrice - tDisc;
                    const tGst = (tTaxable * i.gst) / 100;
                    subTotal += tPrice;
                    discountTotal += tDisc;
                    gstTotal += tGst;
                });
                const grandTotal = subTotal - discountTotal + gstTotal;

                $('#verifySubTotal').text(`₹${subTotal.toFixed(2)}`);
                $('#verifyDiscount').text(`₹${discountTotal.toFixed(2)}`);
                $('#verifyGST').text(`₹${gstTotal.toFixed(2)}`);
                $('#verifyGrandTotal').text(`₹${grandTotal.toFixed(2)}`);
            });
        }

        function startFinalImport() {
            if (!$('#chkVerifyConfirm').is(':checked')) {
                toastr.warning("Please tick the confirmation checkbox to verify invoice calculations.");
                return;
            }

            let subTotal = 0;
            let discountTotal = 0;
            let gstTotal = 0;
            const itemsList = [];

            parsedItems.forEach(item => {
                const totalItemPrice = item.qty * item.purchaseRate;
                const discountAmt = (totalItemPrice * (item.discount || 0)) / 100;
                const taxableAmount = totalItemPrice - discountAmt;
                const itemGstAmount = (taxableAmount * item.gst) / 100;
                const rowTotalPrice = taxableAmount + itemGstAmount;

                subTotal += totalItemPrice;
                discountTotal += discountAmt;
                gstTotal += itemGstAmount;

                itemsList.push({
                    MedicineId: item.medicineId,
                    MedicineName: item.medicineName,
                    BatchNo: item.batchNo,
                    ExpiryDate: item.expiryDate,
                    UnitsPerStrip: item.unitsPerStrip,
                    Qty: item.qty,
                    FreeQty: item.freeQty,
                    PurchaseRate: item.purchaseRate,
                    MRP: item.mrp,
                    SaleRate: item.saleRate,
                    DiscountType: "Percentage",
                    DiscountValue: item.discount || 0,
                    DiscountAmount: discountAmt,
                    GST: item.gst,
                    TotalPrice: rowTotalPrice
                });
            });

            const grandTotal = subTotal - discountTotal + gstTotal;

            const importModel = {
                SupplierId: $('#ImportSupplierId').val(),
                InvoiceNo: $('#ImportInvoiceNo').val(),
                PurchaseDate: $('#ImportPurchaseDate').val(),
                PaymentMode: $('#ImportPaymentMode').val(),
                Remarks: $('#ImportRemarks').val(),
                SubTotal: subTotal,
                DiscountAmount: discountTotal,
                TaxAmount: gstTotal,
                OtherDiscount: 0,
                TotalAmount: grandTotal,
                TransactionGuid: transactionGuid,
                Items: itemsList
            };

            Swal.fire({
                title: 'Confirm Purchase Import',
                text: `Are you sure you want to import this purchase invoice? Net Payable: ₹${grandTotal.toFixed(2)}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1E7E4E',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, start import!',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#global-loader').show();

                    $.ajax({
                        url: '/Purchases/Create',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(importModel),
                        success: function(res) {
                            $('#global-loader').hide();
                            if (res.success) {
                                toastr.success("Purchase imported successfully!");
                                Swal.fire({
                                    title: 'Import Successful!',
                                    text: 'The purchase invoice details and medicine stock have been successfully registered.',
                                    icon: 'success',
                                    confirmButtonColor: '#1E7E4E'
                                }).then(() => {
                                    window.location.href = '/Purchases/Index';
                                });
                            } else {
                                toastr.error(res.message || "Failed to process import.");
                            }
                        },
                        error: function() {
                            $('#global-loader').hide();
                            toastr.error("An error occurred during final import.");
                        }
                    });
                }
            });
        }
    </script>
}
