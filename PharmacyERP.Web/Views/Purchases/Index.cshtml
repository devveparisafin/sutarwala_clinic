@model IEnumerable<PharmacyERP.Web.Models.ViewModels.PurchaseSummaryViewModel>
@{
    ViewData["Title"] = "Purchase History";
}

<div class="container-fluid px-4 mt-4">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800"><i class="fas fa-shopping-cart me-2"></i>Purchase History</h1>
        <div class="d-flex gap-2">
            <a asp-action="Import" class="btn btn-success shadow-sm text-white fw-bold">
                <i class="fas fa-file-import fa-sm me-1"></i> Import Purchases
            </a>
            <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold">
                <i class="fas fa-plus fa-sm text-white-50 me-1"></i> New Purchase
            </a>
        </div>
    </div>

    <div class="card shadow mb-4 border-0">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle" id="purchaseTable" width="100%" cellspacing="0">
                    <thead class="table-light">
                        <tr>
                            <th>Invoice No</th>
                            <th>Purchase Date</th>
                            <th>Supplier</th>
                            <th class="text-end">Sub Total</th>
                            <th class="text-end">Tax Amount</th>
                            <th class="text-end">Net Total</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-primary">@item.InvoiceNo</td>
                                <td>@item.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.SupplierName</td>
                                <td class="text-end">₹@item.SubTotal.ToString("N2")</td>
                                <td class="text-end">₹@item.TaxAmount.ToString("N2")</td>
                                <td class="text-end fw-bold text-dark">₹@item.TotalAmount.ToString("N2")</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white shadow-sm me-1">
                                        <i class="fas fa-eye me-1"></i> View
                                    </a>
                                    <button type="button" class="btn btn-sm btn-danger shadow-sm delete-purchase" data-id="@item.Id" data-invoice="@item.InvoiceNo">
                                        <i class="fas fa-trash me-1"></i> Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#purchaseTable').DataTable({
                "order": [[1, "desc"]],
                "language": {
                    "emptyTable": "No purchases found"
                }
            });

            $(document).on('click', '.delete-purchase', function () {
                var id = $(this).data('id');
                var invoice = $(this).data('invoice');

                Swal.fire({
                    title: 'Are you sure?',
                    text: 'You are about to delete purchase invoice "' + invoice + '". This will reverse the stock batches and supplier balance!',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'Cancel'
                }).then((result) => {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("Delete", "Purchases")',
                            type: 'POST',
                            data: { id: id },
                            success: function (response) {
                                if (response.success) {
                                    toastr.success(response.message);
                                    setTimeout(function () {
                                        location.reload();
                                    }, 1500);
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () {
                                toastr.error('Failed to perform the delete operation.');
                            }
                        });
                    }
                });
            });
        });
    </script>
}
