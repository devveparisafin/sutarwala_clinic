@model PharmacyERP.Web.Models.ViewModels.PurchaseEntryViewModel
@{
    ViewData["Title"] = "New Purchase Entry";
}

<div class="container-fluid px-4">
    <div class="card shadow mb-4 mt-3">
        <div class="card-header py-3 bg-primary text-white d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold">Purchase Invoice Entry</h6>
            <span class="badge bg-light text-primary">Draft</span>
        </div>
        <div class="card-body">
            <form id="purchaseForm">
                <div class="row mb-3 mt-3">
                    <div class="col-md-3">
                        <label asp-for="SupplierId" class="form-label font-weight-bold">Supplier</label>
                        <select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-control select2 form-control-sm">
                            <option value="">-- Select Supplier --</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="InvoiceNo" class="form-label font-weight-bold">Invoice No</label>
                        <input asp-for="InvoiceNo" class="form-control form-control-sm" placeholder="Inv-001" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="PurchaseDate" class="form-label font-weight-bold">Date</label>
                        <input asp-for="PurchaseDate" type="date" class="form-control form-control-sm" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="PaymentMode" class="form-label font-weight-bold">Payment</label>
                        <select asp-for="PaymentMode" class="form-control form-control-sm">
                            <option value="Credit">Credit</option>
                            <option value="Cash">Cash</option>
                            <option value="Online">Online</option>
                        </select>
                    </div>
                </div>

                <div class="table-responsive" style="overflow-x: auto;">
                    <table class="table table-bordered table-sm" id="itemsTable" style="min-width: 1400px;">
                        <thead class="table-dark">
                            <tr class="text-center small">
                                <th style="width: 18%;">Medicine</th>
                                <th style="width: 7%;">Batch</th>
                                <th style="width: 8%;">Expiry</th>
                                <th style="width: 5%;">Packing</th>
                                <th style="width: 5%;">Qty</th>
                                <th style="width: 5%;">Free</th>
                                <th style="width: 7%;">Rate/Strip</th>
                                <th style="width: 7%;">MRP</th>
                                <th style="width: 7%;">S.Rate</th>
                                <th style="width: 6%;">Disc Type</th>
                                <th style="width: 6%;">Disc Val</th>
                                <th style="width: 4%;">GST%</th>
                                <th style="width: 8%;">Total</th>
                                <th style="width: 5%;">Action</th>
                            </tr>
                        </thead>
                        <tbody id="purchaseItems">
                            <!-- Dynamic rows will be added here -->
                        </tbody>
                    </table>
                </div>

                <div class="row mt-3">
                    <div class="col-md-8">
                        <button type="button" class="btn btn-primary btn-sm mb-3" onclick="addRow()">
                            <i class="fas fa-plus"></i> Add Medicine Row
                        </button>
                        <div class="mb-3">
                            <label asp-for="Remarks" class="form-label font-weight-bold">Internal Remarks</label>
                            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Notes about this purchase..."></textarea>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card bg-light">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="font-weight-bold">Sub Total:</span>
                                    <input type="number" id="SubTotal" class="form-control form-control-sm w-50 text-end" readonly value="0.00" />
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="font-weight-bold text-success">Item Discount (-):</span>
                                    <input type="number" id="DiscountAmount" class="form-control form-control-sm w-50 text-end" readonly value="0.00" />
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="font-weight-bold">GST Amount (+):</span>
                                    <input type="number" id="TaxAmount" class="form-control form-control-sm w-50 text-end" readonly value="0.00" />
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="font-weight-bold text-danger">Other Discount (-):</span>
                                    <input type="number" id="OtherDiscount" class="form-control form-control-sm w-50 text-end" onchange="calculateGrandTotal()" value="0.00" step="0.01" />
                                </div>
                                <hr />
                                <div class="d-flex justify-content-between">
                                    <h5 class="font-weight-bold text-primary">Net Payable:</h5>
                                    <input type="number" id="TotalAmount" class="form-control form-control-lg w-50 text-end font-weight-bold text-primary border-0 bg-transparent" readonly value="0.00" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-between mb-5">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">Back to List</a>
                    <button type="button" onclick="submitPurchase()" class="btn btn-success btn-lg px-5 shadow">
                        <i class="fas fa-save me-2"></i>SAVE PURCHASE INVOICE
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.select2').select2({ theme: 'bootstrap-5' });
            
            setTimeout(() => {
                $('#SupplierId').select2('open');
            }, 200);

            addRow(false);
        });

        function addRow(autoOpen = true) {
            const rowId = Date.now();
            const rowHtml = `
                <tr id="row_${rowId}" class="small">
                    <td>
                        <select class="form-control form-control-sm medicine-select"></select>
                    </td>
                    <td><input type="text" class="form-control form-control-sm batch-input text-uppercase" placeholder="BATCH" /></td>
                    <td><input type="text" class="form-control form-control-sm expiry-input" placeholder="MM/YY" maxlength="5" onkeyup="formatExpiry(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm packing-input text-center" value="1" onchange="calculateRow(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm qty-input text-center" value="1" onchange="calculateRow(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm free-input text-center" value="0" onchange="calculateRow(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm prate-input text-end" value="0" step="0.01" onchange="calculateRow(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm mrp-input text-end" value="0" step="0.01" /></td>
                    <td><input type="number" class="form-control form-control-sm srate-input text-end" value="0" step="0.01" /></td>
                    <td>
                        <select class="form-control form-control-sm disc-type text-center" onchange="calculateRow(this)">
                            <option value="Percentage">%</option>
                            <option value="Fixed">Amt</option>
                        </select>
                    </td>
                    <td><input type="number" class="form-control form-control-sm disc-val text-end" value="0" step="0.01" onchange="calculateRow(this)" /></td>
                    <td><input type="number" class="form-control form-control-sm gst-input text-center bg-light" value="0" readonly /></td>
                    <td><input type="number" class="form-control form-control-sm row-total text-end bg-light font-weight-bold" value="0" readonly /></td>
                    <td class="text-center">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-success" onclick="addRow()" title="Add Row"><i class="fas fa-plus"></i></button>
                            <button type="button" class="btn btn-outline-danger" onclick="removeRow(${rowId})" title="Remove Row"><i class="fas fa-trash"></i></button>
                        </div>
                    </td>
                </tr>
            `;
            $('#purchaseItems').append(rowHtml);
            
            var $select = $(`#row_${rowId} .medicine-select`);
            $select.select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: 'Medicine...',
                minimumInputLength: 1,
                ajax: {
                    url: '/Purchases/SearchMedicine',
                    dataType: 'json',
                    delay: 250,
                    data: function (params) { return { term: params.term }; },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.id,
                                    text: item.text,
                                    gst: item.gst,
                                    unitsPerStrip: item.unitsPerStrip
                                }
                            })
                        };
                    },
                    cache: true
                }
            }).on('select2:select', function(e) {
                var data = e.params.data;
                var $row = $(this).closest('tr');
                
                $row.find('input.gst-input').val(data.gst || 0);
                $row.find('input.packing-input').val(data.unitsPerStrip || 1);
                
                calculateRow(this);
                
                setTimeout(() => {
                    $row.find('input.batch-input').focus();
                }, 100);
            });

            if (autoOpen) {
                setTimeout(() => {
                    $select.select2('open');
                }, 100);
            }
        }

        $(document).on('select2:open', () => {
            setTimeout(() => {
                const searchField = document.querySelector('.select2-search__field');
                if (searchField) searchField.focus();
            }, 10);
        });

        function removeRow(rowId) {
            $(`#row_${rowId}`).remove();
            calculateGrandTotal();
        }

        function calculateRow(input) {
            const row = $(input).closest('tr');
            const qty = parseFloat(row.find('.qty-input').val()) || 0;
            const rate = parseFloat(row.find('.prate-input').val()) || 0;
            const gstPercent = parseFloat(row.find('.gst-input').val()) || 0;
            const discType = row.find('.disc-type').val();
            const discVal = parseFloat(row.find('.disc-val').val()) || 0;
            
            const subtotal = qty * rate;
            let discount = 0;
            
            if (discType === 'Percentage') {
                discount = (subtotal * discVal) / 100;
            } else {
                discount = discVal;
            }
            
            const taxableAmount = subtotal - discount;
            const tax = (taxableAmount * gstPercent) / 100;
            const total = taxableAmount + tax;
            
            row.find('.row-total').val(total.toFixed(2));
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let subTotal = 0;
            let taxTotal = 0;
            let itemDiscountTotal = 0;
            
            $('#purchaseItems tr').each(function() {
                const qty = parseFloat($(this).find('.qty-input').val()) || 0;
                const rate = parseFloat($(this).find('.prate-input').val()) || 0;
                const gstPercent = parseFloat($(this).find('.gst-input').val()) || 0;
                const discType = $(this).find('.disc-type').val();
                const discVal = parseFloat($(this).find('.disc-val').val()) || 0;
                
                const st = qty * rate;
                let disc = 0;
                if (discType === 'Percentage') {
                    disc = (st * discVal) / 100;
                } else {
                    disc = discVal;
                }
                
                const taxable = st - disc;
                const tax = (taxable * gstPercent) / 100;
                
                subTotal += st;
                itemDiscountTotal += disc;
                taxTotal += tax;
            });
            
            const otherDiscount = parseFloat($('#OtherDiscount').val()) || 0;
            
            $('#SubTotal').val(subTotal.toFixed(2));
            $('#DiscountAmount').val(itemDiscountTotal.toFixed(2));
            $('#TaxAmount').val(taxTotal.toFixed(2));
            
            const netTotal = (subTotal - itemDiscountTotal + taxTotal) - otherDiscount;
            $('#TotalAmount').val(netTotal.toFixed(2));
        }

        function formatExpiry(input) {
            let val = input.value.replace(/\D/g, '');
            if (val.length > 2) {
                val = val.substring(0, 2) + '/' + val.substring(2, 4);
            }
            input.value = val;
        }

        function parseExpiry(mmYY) {
            if (!mmYY || !mmYY.includes('/')) return null;
            const parts = mmYY.split('/');
            const month = parseInt(parts[0]);
            const year = parseInt('20' + parts[1]);
            if (isNaN(month) || isNaN(year) || month < 1 || month > 12) return null;
            
            // Return last day of the month
            const date = new Date(year, month, 0); 
            return date.toISOString().split('T')[0]; // yyyy-mm-dd
        }

        function submitPurchase() {
            const model = {
                SupplierId: $('#SupplierId').val(),
                InvoiceNo: $('#InvoiceNo').val(),
                PurchaseDate: $('#PurchaseDate').val(),
                PaymentMode: $('#PaymentMode').val(),
                Remarks: $('#Remarks').val(),
                SubTotal: parseFloat($('#SubTotal').val()),
                DiscountAmount: parseFloat($('#DiscountAmount').val()),
                TaxAmount: parseFloat($('#TaxAmount').val()),
                OtherDiscount: parseFloat($('#OtherDiscount').val()),
                TotalAmount: parseFloat($('#TotalAmount').val()),
                Items: []
            };

            $('#purchaseItems tr').each(function() {
                const medicineData = $(this).find('.medicine-select').select2('data')[0];
                if (medicineData && medicineData.id) {
                    const row = $(this);
                    
                    // Calculate individual item discount amount for the model
                    const st = parseFloat(row.find('.qty-input').val()) * parseFloat(row.find('.prate-input').val());
                    let discAmt = 0;
                    if (row.find('.disc-type').val() === 'Percentage') {
                        discAmt = (st * parseFloat(row.find('.disc-val').val())) / 100;
                    } else {
                        discAmt = parseFloat(row.find('.disc-val').val());
                    }

                    model.Items.push({
                        MedicineId: medicineData.id,
                        MedicineName: medicineData.text,
                        BatchNo: row.find('.batch-input').val(),
                        ExpiryDate: parseExpiry(row.find('.expiry-input').val()),
                        UnitsPerStrip: parseInt(row.find('.packing-input').val()),
                        Qty: parseInt(row.find('.qty-input').val()),
                        FreeQty: parseInt(row.find('.free-input').val()),
                        PurchaseRate: parseFloat(row.find('.prate-input').val()),
                        MRP: parseFloat(row.find('.mrp-input').val()),
                        SaleRate: parseFloat(row.find('.srate-input').val()),
                        DiscountType: row.find('.disc-type').val(),
                        DiscountValue: parseFloat(row.find('.disc-val').val()),
                        DiscountAmount: discAmt,
                        GST: parseFloat(row.find('.gst-input').val()),
                        TotalPrice: parseFloat(row.find('.row-total').val())
                    });
                }
            });

            if (!model.SupplierId) { toastr.error("Select Supplier"); return; }
            if (!model.InvoiceNo) { toastr.error("Enter Invoice No"); return; }
            if (model.Items.length === 0) { toastr.error("Add at least one medicine"); return; }
            
            // Validate Expiry
            for(let item of model.Items) {
                if(!item.ExpiryDate) {
                    toastr.error(`Invalid Expiry Date for ${item.MedicineName}. Use MM/YY format.`);
                    return;
                }
            }

            $.ajax({
                url: '/Purchases/Create',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(model),
                success: function(res) {
                    if (res.success) {
                        toastr.success(res.message);
                        window.location.href = res.redirectUrl;
                    } else {
                        toastr.error(res.message);
                    }
                }
            });
        }
    </script>
}
