@model PharmacyERP.Web.Models.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = (Model.Id == null ? "Create User" : "Edit User");
}

<div class="container-fluid px-4 mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h6 class="m-0 font-weight-bold">@(Model.Id == null ? "Add New System User" : "Edit User Details")</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="@(Model.Id == null ? "Create" : "Edit")" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="John Doe" tabindex="1" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Username" class="form-label fw-bold"></label>
                                <input asp-for="Username" class="form-control" placeholder="username" tabindex="2" />
                                <span asp-validation-for="Username" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="RoleId" class="form-label fw-bold"></label>
                                <select asp-for="RoleId" asp-items="Model.Roles" class="form-select" tabindex="3">
                                    <option value="">-- Select Role --</option>
                                </select>
                                <span asp-validation-for="RoleId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold"></label>
                            <input asp-for="Email" class="form-control" placeholder="email@example.com" tabindex="4" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <hr />
                        <h6 class="text-primary fw-bold mb-3">Password Security</h6>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Password" class="form-label fw-bold"></label>
                                <input asp-for="Password" class="form-control" placeholder="@(Model.Id == null ? "Enter password" : "Leave blank to keep current")" tabindex="5" />
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold"></label>
                                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" tabindex="6" />
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" tabindex="7">
                                <label asp-for="IsActive" class="form-check-label fw-bold">Active Account</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-light px-4 me-md-2" tabindex="9">Cancel</a>
                            <button type="submit" class="btn btn-primary px-5" tabindex="8">
                                <i class="fas fa-save me-2"></i>@(Model.Id == null ? "Create User" : "Update User")
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Auto-focus the first field
            $('#FullName').focus();

            // Handle Select2 logic if any (RoleId is a standard select here, but we can make it auto-next)
            $('input, select').on('change', function() {
                if($(this).attr('tabindex')) {
                   // move focus on change for select elements
                   if($(this).is('select')) {
                       var nextTab = parseInt($(this).attr('tabindex')) + 1;
                       $('[tabindex="' + nextTab + '"]').focus();
                   }
                }
            });
        });
    </script>
}
