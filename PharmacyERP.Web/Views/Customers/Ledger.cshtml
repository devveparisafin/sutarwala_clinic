@model PharmacyERP.Web.Models.ViewModels.CustomerLedgerViewModel
@{
    ViewData["Title"] = "Customer Ledger";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex justify-content-between align-items-center">
            <h6 class="m-0 font-weight-bold text-primary">Customer Ledger: @Model.CustomerName (@Model.MobileNumber)</h6>
            <div>
                <span class="badge bg-primary text-white p-2">Current Balance: ₹@Model.CurrentBalance.ToString("N2")</span>
                <button class="btn btn-sm btn-success ms-2" data-bs-toggle="modal" data-bs-target="#paymentModal">Receive Payment</button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped" id="ledgerTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Reference</th>
                            <th class="text-end">Debit (Sale)</th>
                            <th class="text-end">Credit (Paid)</th>
                            <th class="text-end">Running Balance</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.Entries)
                        {
                            <tr>
                                <td>@entry.Date.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@entry.Description</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(entry.ReferenceId))
                                    {
                                        <a href="/Sales/Receipt/@entry.ReferenceId" target="_blank">@entry.Reference</a>
                                    }
                                    else
                                    {
                                        @entry.Reference
                                    }
                                </td>
                                <td class="text-end">@(entry.Debit > 0 ? entry.Debit.ToString("N2") : "-")</td>
                                <td class="text-end">@(entry.Credit > 0 ? entry.Credit.ToString("N2") : "-")</td>
                                <td class="text-end font-weight-bold">@entry.Balance.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="font-weight-bold">
                            <td colspan="3" class="text-end">Totals:</td>
                            <td class="text-end text-danger">₹@Model.Entries.Sum(x => x.Debit).ToString("N2")</td>
                            <td class="text-end text-success">₹@Model.Entries.Sum(x => x.Credit).ToString("N2")</td>
                            <td class="text-end text-primary">₹@Model.CurrentBalance.ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Receive Payment</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="paymentForm">
                    <input type="hidden" id="CustomerId" value="@ViewContext.RouteData.Values["id"]" />
                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <input type="number" id="Amount" class="form-control" required step="0.01" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Payment Mode</label>
                        <select id="PaymentMode" class="form-control">
                            <option value="Cash">Cash</option>
                            <option value="UPI">UPI</option>
                            <option value="Card">Card</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Reference No</label>
                        <input type="text" id="ReferenceNo" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Remarks</label>
                        <input type="text" id="Remarks" class="form-control" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="submitPayment()">Save Payment</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function submitPayment() {
            let data = {
                CustomerId: $('#CustomerId').val(),
                Amount: parseFloat($('#Amount').val()),
                PaymentMode: $('#PaymentMode').val(),
                ReferenceNo: $('#ReferenceNo').val(),
                Remarks: $('#Remarks').val()
            };

            if (!data.Amount || data.Amount <= 0) {
                toastr.error("Please enter a valid amount.");
                return;
            }

            $.ajax({
                url: '/Customers/AddPayment',
                type: 'POST',
                data: data,
                success: function(res) {
                    if (res.success) {
                        toastr.success(res.message);
                        setTimeout(() => location.reload(), 500);
                    } else {
                        toastr.error(res.message);
                    }
                }
            });
        }
    </script>
}
