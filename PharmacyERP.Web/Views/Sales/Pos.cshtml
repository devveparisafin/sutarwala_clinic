@model PharmacyERP.Web.Models.ViewModels.SalesEntryViewModel
@{
    ViewData["Title"] = "POS Billing";
    Layout = "_Layout";
}

@* Styles are now in site.css *@

<div class="pos-container">
    <!-- Main Area: Search + Table -->
    <div class="pos-main">
        <div class="card mb-3 border-0 shadow-sm">
            <div class="card-body p-3">
                <div class="row align-items-center g-3">
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text bg-primary text-white border-0"><i class="fas fa-search"></i></span>
                            <select id="medSearch" class="form-control border-start-0" tabindex="1"></select>
                            <span class="input-group-text bg-white small fw-bold">F2</span>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text bg-light border-0"><i class="fas fa-barcode"></i></span>
                            <input type="text" id="barcodeInput" class="form-control" placeholder="Barcode..." tabindex="2" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card flex-grow-1 border-0 shadow-sm overflow-hidden">
            <!-- Desktop Table -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle" id="posTable">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4">Medicine</th>
                            <th style="width: 180px;">Type</th>
                            <th style="width: 120px;">Qty</th>
                            <th class="text-center" style="width: 100px;">GST%</th>
                            <th class="text-end pe-4" style="width: 150px;">Total</th>
                            <th style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="cartItems">
                        <!-- Items will be added here -->
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card List -->
            <div class="d-md-none p-2" id="cartItemsMobile">
                <!-- Mobile items will be added here -->
            </div>
            
            <div id="emptyCartMsg" class="text-center py-5">
                <i class="fas fa-shopping-basket fa-3x text-light mb-3"></i>
                <h6 class="text-muted">No items in cart.</h6>
                <p class="text-secondary small">Search medicine to start billing</p>
            </div>
        </div>
    </div>

    <!-- Sidebar Area: Summary -->
    <div class="pos-sidebar shadow-sm">
        <div class="p-4 flex-grow-1 overflow-auto">
            <h6 class="fw-bold text-dark mb-4 text-uppercase letter-spacing-1">
                <i class="fas fa-file-invoice-dollar me-2 text-primary"></i> Billing Summary
            </h6>
            
            <div class="mb-4">
                <label class="form-label small">Customer Details</label>
                <div class="d-flex mb-2 gap-2">
                    <select id="customerSearch" class="form-control flex-grow-1" tabindex="3"></select>
                    <button type="button" id="btnViewPrescription" class="btn btn-sm btn-info text-white d-none" onclick="viewCustomerPrescriptions()" title="View Prescriptions">
                        <i class="fas fa-file-medical"></i>
                    </button>
                </div>
                <input type="text" id="CustomerName" class="form-control mb-2 form-control-sm" value="Walk-in Customer" placeholder="Name" tabindex="4" />
                <input type="text" id="CustomerPhone" class="form-control form-control-sm" placeholder="Phone" tabindex="5" />
                <input type="hidden" id="SelectedCustomerId" />
                <input type="hidden" id="PrescriptionId" value="@ViewBag.PrescriptionId" />
            </div>

            <hr class="my-4 opacity-5" />

            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-secondary">Sub Total</span>
                <span id="lblSubTotal" class="fw-bold">₹0.00</span>
            </div>
            <div class="d-flex justify-content-between mb-2 small">
                <span class="text-secondary">Tax Total</span>
                <span id="lblTax" class="fw-bold text-info">₹0.00</span>
            </div>
            <div class="d-flex justify-content-between align-items-center mb-4">
                <span class="text-secondary small">Discount</span>
                <div class="input-group input-group-sm" style="width: 100px;">
                    <input type="number" id="DiscountAmount" class="form-control text-end" value="0" onchange="calculateGrandTotal()" tabindex="6" />
                </div>
            </div>

            <div class="card bg-primary text-white border-0 mb-4 shadow-sm">
                <div class="card-body p-4 text-center">
                    <div class="small opacity-75 mb-1">PAYABLE AMOUNT</div>
                    <div id="lblGrandTotal" class="total-badge text-white">₹0.00</div>
                </div>
            </div>

            <div class="mb-4">
                <label class="form-label small">Payment Mode</label>
                <select id="PaymentMode" class="form-select form-select-sm" tabindex="7">
                    <option value="Cash">Cash</option>
                    <option value="UPI">UPI / QR</option>
                    <option value="Card">Card</option>
                </select>
            </div>
        </div>

        <div class="p-4 border-top" id="posActionButtons">
            <button onclick="processSale('print')" class="btn btn-primary btn-lg w-100 py-3 mb-2 shadow-sm fw-bold" id="btnSavePrint" tabindex="8">
                <i class="fas fa-print me-2"></i> SAVE & PRINT [F10]
            </button>
            <div class="d-flex gap-2">
                <button onclick="processSale('new')" class="btn btn-success btn-sm w-50 py-2 shadow-sm text-white fw-bold" id="btnSaveNew">
                    <i class="fas fa-plus me-1"></i> Save & New
                </button>
                <button onclick="processSale('stay')" class="btn btn-info btn-sm w-50 py-2 shadow-sm text-white fw-bold" id="btnSaveStay">
                    <i class="fas fa-save me-1"></i> Save & Stay
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Receipt Printing Container -->
<div id="printSection" style="display:none;"></div>

<!-- Sale Type Selection Modal -->
<div class="modal fade" id="saleTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-primary text-white py-2">
                <h6 class="modal-title"><i class="fas fa-shopping-cart me-2"></i>Select Sale Type</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <p id="modalMedName" class="font-weight-bold text-dark mb-3"></p>
                <div class="d-grid gap-2">
                    <button type="button" class="btn btn-outline-primary py-3" onclick="confirmAddToCart(false)">
                        <i class="fas fa-layer-group fa-lg d-block mb-1"></i>
                        <strong>STRIP SALE</strong><br/>
                        <small id="modalStripInfo"></small>
                    </button>
                    <button type="button" class="btn btn-outline-info py-3" onclick="confirmAddToCart(true)">
                        <i class="fas fa-tablet-alt fa-lg d-block mb-1"></i>
                        <strong>LOOSE SALE</strong><br/>
                        <small>Single Units</small>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Prescription Viewer Modal -->
<div class="modal fade" id="prescriptionModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title"><i class="fas fa-file-medical me-2"></i>Customer Prescriptions</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body bg-light">
                <div id="prescriptionContainer" class="row g-3">
                    <!-- Loaded via AJAX -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Hidden Receipt Printing Container -->
<div id="printSection" style="display:none;"></div>

@section Scripts {
    <script>
        const DEFAULT_GST = @ViewBag.DefaultGst;
        let cart = [];

        function generateGuid() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }
        let currentTransactionGuid = generateGuid();

        function formatMedicine(med) {
            if (!med.id) return med.text;
            const stockBadge = med.isOutOfStock ? 
                '<span class="badge bg-danger text-white">Out of Stock</span>' : 
                `<span class="badge bg-light text-dark border me-2">Stock: ${med.stock}</span>`;
            
            return $(`
                <div class="d-flex justify-content-between align-items-center">
                    <div class="flex-grow-1">
                        <span class="fw-bold text-primary">${med.name}</span>
                        <br/><small class="text-muted">Packing: 1x${med.unitsPerStrip} | ${med.isLooseSale ? 'Loose Available' : 'No Loose Sale'}</small>
                    </div>
                    <div>
                        ${stockBadge}
                        <span class="badge bg-info text-white"><i class="fas fa-th"></i> Rack: ${med.rack}</span>
                    </div>
                </div>
            `);
        }

        function formatMedicineSelection(med) {
            return med.name || med.text;
        }

        $(document).ready(function() {
            $('#medSearch').focus();

            $('#medSearch').select2({
                placeholder: 'Search Medicine (F2)...',
                dropdownParent: $(document.body),
                ajax: {
                    url: '/Sales/SearchMedicine',
                    dataType: 'json',
                    delay: 250,
                    data: (params) => ({ term: params.term }),
                    processResults: (data) => ({ results: data })
                },
                templateResult: formatMedicine,
                templateSelection: formatMedicineSelection
            }).on('select2:select', function(e) {
                addToCart(e.params.data);
                $(this).val(null).trigger('change');
                setTimeout(() => $('#medSearch').select2('open'), 100);
            });

            // Customer Search
            QuickAddManager.init('#customerSearch', 'Customer', {
                placeholder: 'Search Registered Customer (F3)...',
                allowClear: true,
                ajax: {
                    url: '/Sales/SearchCustomers',
                    dataType: 'json',
                    delay: 250,
                    data: (params) => ({ term: params.term }),
                    processResults: (data) => ({ results: data })
                }
            });

            $('#customerSearch').on('select2:select', function(e) {
                let data = e.params.data;
                $('#SelectedCustomerId').val(data.id);
                $('#CustomerName').val(data.name);
                $('#CustomerPhone').val(data.phone);
                $('#btnViewPrescription').removeClass('d-none');
            }).on('select2:unselect', function(e) {
                $('#SelectedCustomerId').val('');
                $('#btnViewPrescription').addClass('d-none');
            });

            // Focus search box automatically when Select2 opens
            $(document).on('select2:open', () => {
                document.querySelector('.select2-search__field').focus();
            });

            // Keyboard Shortcuts
            $(document).keydown(function(e) {
                if (e.which == 113) { // F2
                    $('#medSearch').select2('open');
                    e.preventDefault();
                }
                if (e.which == 114) { // F3
                    $('#customerSearch').select2('open');
                    e.preventDefault();
                }
                if (e.which == 121) { // F10
                    processSale('print');
                    e.preventDefault();
                }
                if (e.which == 27) { // Esc
                    if (confirm("Clear entire cart?")) {
                        clearCart();
                    }
                }
            });

            // Barcode Input
            $('#barcodeInput').keypress(function(e) {
                if (e.which == 13) { // Enter
                    let code = $(this).val();
                    if (code) {
                        $.get('/Sales/SearchMedicine?term=' + code, function(res) {
                            if (res.length > 0) {
                                addToCart(res[0]);
                                $('#barcodeInput').val('');
                            } else {
                                toastr.error("Medicine not found!");
                            }
                        });
                    }
                }
            });

            // Load Doctor Prescription if provided
            let pId = $('#PrescriptionId').val();
            if (pId) {
                loadPrescriptionData(pId);
            }
        });

        function loadPrescriptionData(pId) {
            Swal.fire({
                title: 'Loading Prescription...',
                html: '<div class="spinner-border text-primary my-3" role="status"><span class="visually-hidden">Loading...</span></div>',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => { Swal.showLoading(); }
            });

            $.get('/DoctorPrescription/GetPrescriptionDetails?id=' + pId, function(res) {
                Swal.close();
                if (res.success) {
                    $('#CustomerName').val(res.patientName);
                    if (res.patientPhone) {
                        $('#CustomerPhone').val(res.patientPhone);
                    }
                    
                    if (res.items && res.items.length > 0) {
                        res.items.forEach(med => {
                            if (med.stock <= 0) {
                                toastr.warning(`${med.name} is prescribed but is out of stock!`);
                                return;
                            }
                            
                            cart.push({
                                id: med.id,
                                name: med.name,
                                stripRate: med.price,
                                gst: med.gst,
                                qty: med.prescribedQty,
                                isLoose: false,
                                unitsPerStrip: med.unitsPerStrip,
                                stock: med.stock,
                                isLooseAllowed: med.isLooseSale
                            });
                        });
                        
                        renderCart();
                        toastr.success("Prescription loaded successfully into POS cart!");
                    } else {
                        toastr.error("No active medicines found in this prescription.");
                    }
                } else {
                    toastr.error("Error loading prescription details: " + res.message);
                }
            }).fail(function() {
                Swal.close();
                toastr.error("An error occurred while loading prescription details.");
            });
        }

        function viewCustomerPrescriptions() {
            const customerId = $('#SelectedCustomerId').val();
            if (!customerId) return;
            
            $.get('/Customer/GetPrescriptions?customerId=' + customerId, function(res) {
                if (res.success) {
                    let html = '';
                    if (res.data.length === 0) {
                        html = '<div class="col-12 text-center p-4 text-muted"><i class="fas fa-file-image fa-3x mb-3 text-gray-300"></i><p>No prescriptions uploaded for this customer.</p></div>';
                    } else {
                        res.data.forEach(doc => {
                            const date = new Date(doc.prescriptionDate).toLocaleDateString();
                            const docName = doc.doctorName || 'Unknown Doctor';
                            
                            let contentHtml = '';
                            if (doc.imagePath && doc.imagePath.endsWith(".pdf")) {
                                contentHtml = `<div class="text-center p-4 bg-white border rounded"><i class="fas fa-file-pdf fa-4x text-danger"></i><a href="${doc.imagePath}" target="_blank" class="btn btn-sm btn-outline-danger mt-3 d-block">View PDF</a></div>`;
                            } else {
                                contentHtml = `<img src="${doc.imagePath}" class="img-fluid rounded border" alt="Prescription" style="width: 100%; height: 200px; object-fit: cover; cursor: pointer;" onclick="window.open('${doc.imagePath}', '_blank')" />`;
                            }
                            
                            html += `
                                <div class="col-md-6 col-lg-4">
                                    <div class="card h-100 border-0 shadow-sm">
                                        ${contentHtml}
                                        <div class="card-body p-2 text-center">
                                            <small class="text-muted d-block"><i class="fas fa-calendar-alt me-1"></i> ${date}</small>
                                            <small class="fw-bold d-block text-truncate" title="${docName}"><i class="fas fa-user-md me-1"></i> ${docName}</small>
                                        </div>
                                    </div>
                                </div>
                            `;
                        });
                    }
                    $('#prescriptionContainer').html(html);
                    $('#prescriptionModal').modal('show');
                }
            });
        }

        function addToCart(med) {
            if (med.isOutOfStock) {
                toastr.error("This medicine is currently out of stock!");
                return;
            }
            // Check if already in cart
            let existing = cart.find(x => x.id === med.id);
            if (existing) {
                // If existing, we increment based on its current type (Strip or Loose)
                const requestedUnits = existing.isLoose ? 1 : med.unitsPerStrip;
                if (getTotalCartUnits(med.id) + requestedUnits > med.stock) {
                    toastr.error("Insufficient stock!");
                    return;
                }
                existing.qty++;
            } else {
                // Default to Strip Sale
                if (med.stock < med.unitsPerStrip) {
                    // If not enough for a strip, try loose if allowed
                    if (med.isLooseSale && med.stock > 0) {
                        cart.push({
                            id: med.id, name: med.name, stripRate: med.price, gst: med.gst,
                            qty: 1, isLoose: true, unitsPerStrip: med.unitsPerStrip, stock: med.stock
                        });
                    } else {
                        toastr.error("Insufficient stock!");
                        return;
                    }
                } else {
                    cart.push({
                        id: med.id, name: med.name, stripRate: med.price, gst: med.gst,
                        qty: 1, isLoose: false, unitsPerStrip: med.unitsPerStrip, stock: med.stock,
                        isLooseAllowed: med.isLooseSale
                    });
                }
            }
            renderCart();
        }

        function getTotalCartUnits(medId) {
            return cart
                .filter(x => x.id === medId)
                .reduce((acc, x) => acc + (x.isLoose ? x.qty : x.qty * x.unitsPerStrip), 0);
        }

        function renderCart() {
            let html = '';
            let mobileHtml = '';
            cart.forEach((item, index) => {
                const stripRate = item.stripRate;
                const looseRate = stripRate / item.unitsPerStrip;
                const currentRate = item.isLoose ? looseRate : stripRate;
                
                const subtotal = item.qty * currentRate;
                const total = subtotal * (1 + item.gst / 100);
                
                const inventoryDeduction = item.isLoose ? item.qty : (item.qty * item.unitsPerStrip);

                // Desktop Table Row
                html += `
                    <tr>
                        <td>
                            <div class="fw-bold text-dark">${item.name}</div>
                            <div class="small text-muted mt-1">Packing: 1x${item.unitsPerStrip} | Units: ${inventoryDeduction}</div>
                        </td>
                        <td style="width: 150px;">
                            <select class="form-select form-select-sm" onchange="updateItem(${index}, 'isLoose', this.value === 'true')">
                                <option value="false" ${!item.isLoose ? 'selected' : ''}>Strip Sale</option>
                                <option value="true" ${item.isLoose ? 'selected' : ''} ${!item.isLooseAllowed ? 'disabled' : ''}>Loose Sale</option>
                            </select>
                            <small class="text-muted d-block mt-1">Strip: ₹${stripRate.toFixed(2)} | Loose: ₹${looseRate.toFixed(2)}</small>
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm text-center" value="${item.qty}" onchange="updateItem(${index}, 'qty', this.value)" min="1" />
                        </td>
                        <td class="text-center">${item.gst}%</td>
                        <td class="fw-bold text-end text-primary">₹${total.toFixed(2)}</td>
                        <td class="text-center"><button class="btn btn-link text-danger p-0" onclick="removeItem(${index})"><i class="fas fa-trash-alt"></i></button></td>
                    </tr>
                `;

                // Mobile Card Item
                mobileHtml += `
                    <div class="card mb-3 border-0 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <div class="fw-bold text-dark fs-6">${item.name}</div>
                                    <div class="text-muted small">Stock: ${item.stock} | Rack: ${item.rack}</div>
                                </div>
                                <button class="btn btn-sm btn-light text-danger rounded-circle p-2" onclick="removeItem(${index})">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                            
                            <div class="row g-3 align-items-center">
                                <div class="col-7">
                                    <div class="small text-muted mb-1">Sale Type</div>
                                    <select class="form-select form-select-sm" onchange="updateItem(${index}, 'isLoose', this.value === 'true')">
                                        <option value="false" ${!item.isLoose ? 'selected' : ''}>Full Strip (₹${stripRate.toFixed(2)})</option>
                                        <option value="true" ${item.isLoose ? 'selected' : ''} ${!item.isLooseAllowed ? 'disabled' : ''}>Loose Sale (₹${looseRate.toFixed(2)})</option>
                                    </select>
                                </div>
                                <div class="col-5">
                                    <div class="small text-muted mb-1">Quantity</div>
                                    <div class="input-group input-group-sm">
                                        <button class="btn btn-outline-secondary px-2" onclick="updateItem(${index}, 'qty', ${item.qty - 1})">-</button>
                                        <input type="number" class="form-control text-center p-0 fw-bold" value="${item.qty}" onchange="updateItem(${index}, 'qty', this.value)" />
                                        <button class="btn btn-outline-secondary px-2" onclick="updateItem(${index}, 'qty', ${item.qty + 1})">+</button>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <div class="text-muted small">Tax: ${item.gst}%</div>
                                <div class="fw-bold text-primary fs-5">₹${total.toFixed(2)}</div>
                            </div>
                        </div>
                    </div>
                `;
            });
            $('#cartItems').html(html);
            $('#cartItemsMobile').html(mobileHtml);
            
            if (cart.length > 0) {
                $('#emptyCartMsg').addClass('d-none');
            } else {
                $('#emptyCartMsg').removeClass('d-none');
            }
            
            calculateGrandTotal();
        }

        function updateItem(index, prop, val) {
            const item = cart[index];
            if (prop === 'qty') {
                val = parseInt(val);
                const currentUnits = item.isLoose ? val : val * item.unitsPerStrip;
                const otherRowsUnits = cart
                    .filter((x, i) => x.id === item.id && i !== index)
                    .reduce((acc, x) => acc + (x.isLoose ? x.qty : x.qty * x.unitsPerStrip), 0);

                if (currentUnits + otherRowsUnits > item.stock) {
                    toastr.error("Insufficient stock!");
                    val = item.qty; 
                }
            }
            if (prop === 'isLoose') {
                // When switching to loose, check if we have enough stock for the current quantity
                const requestedUnits = val ? item.qty : (item.qty * item.unitsPerStrip);
                if (requestedUnits > item.stock) {
                    toastr.error("Insufficient stock for this conversion!");
                    return renderCart();
                }
            }
            item[prop] = val;
            renderCart();
        }

        function removeItem(index) {
            cart.splice(index, 1);
            renderCart();
        }

        function clearCart() {
            cart = [];
            renderCart();
        }

        function calculateGrandTotal() {
            let subTotal = 0;
            let taxTotal = 0;
            
            cart.forEach(item => {
                const looseRate = item.stripRate / item.unitsPerStrip;
                const currentRate = item.isLoose ? looseRate : item.stripRate;
                const st = item.qty * currentRate;
                const tax = (st * item.gst) / 100;
                subTotal += st;
                taxTotal += tax;
            });

            let discount = parseFloat($('#DiscountAmount').val()) || 0;
            let grandTotal = subTotal + taxTotal - discount;

            $('#lblSubTotal').text('₹' + subTotal.toFixed(2));
            $('#lblTax').text('₹' + taxTotal.toFixed(2));
            $('#lblGrandTotal').text('₹' + grandTotal.toFixed(2));
        }

        function disableActionButtons() {
            $('#btnSavePrint').attr('disabled', true);
            $('#btnSaveNew').attr('disabled', true);
            $('#btnSaveStay').attr('disabled', true);
        }

        function enableActionButtons() {
            $('#btnSavePrint').removeAttr('disabled');
            $('#btnSaveNew').removeAttr('disabled');
            $('#btnSaveStay').removeAttr('disabled');
        }

        function processSale(action) {
            if (cart.length === 0) {
                toastr.error("Cart is empty!");
                return;
            }

            let model = {
                CustomerName: $('#CustomerName').val(),
                CustomerPhone: $('#CustomerPhone').val(),
                PaymentMode: $('#PaymentMode').val(),
                PrescriptionId: $('#PrescriptionId').val(),
                DiscountAmount: parseFloat($('#DiscountAmount').val()) || 0,
                SubTotal: parseFloat($('#lblSubTotal').text().replace('₹', '')),
                TaxAmount: parseFloat($('#lblTax').text().replace('₹', '')),
                TotalAmount: parseFloat($('#lblGrandTotal').text().replace('₹', '')),
                TransactionGuid: currentTransactionGuid,
                Items: cart.map(x => {
                    const looseRate = x.stripRate / x.unitsPerStrip;
                    const currentRate = x.isLoose ? looseRate : x.stripRate;
                    return {
                        MedicineId: x.id,
                        Qty: x.qty,
                        IsLoose: x.isLoose,
                        Rate: currentRate,
                        GST: x.gst,
                        TotalPrice: (x.qty * currentRate) * (1 + x.gst / 100)
                    };
                })
            };

            Swal.fire({
                title: 'Confirm Sale?',
                text: `Are you sure you want to save this sale? Total Amount: ₹${model.TotalAmount.toFixed(2)}`,
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#1cc88a',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Yes, Save Sale',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    disableActionButtons();
                    Swal.fire({
                        title: 'Saving data, please wait...',
                        html: '<div class="spinner-border text-primary my-3" role="status"><span class="visually-hidden">Loading...</span></div>',
                        allowOutsideClick: false,
                        showConfirmButton: false,
                        didOpen: () => {
                            Swal.showLoading();
                        }
                    });

                    $.ajax({
                        url: '/Sales/Pos',
                        type: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(model),
                        success: function(res) {
                            Swal.close();
                            if (res.success) {
                                toastr.success(res.message);
                                
                                if (action === 'print') {
                                    window.open('/Sales/Receipt/' + res.saleId, '_blank');
                                    resetPOSCart();
                                } else if (action === 'new') {
                                    resetPOSCart();
                                } else if (action === 'stay') {
                                    // Lock current form
                                    $('#CustomerName').attr('readonly', true);
                                    $('#CustomerPhone').attr('readonly', true);
                                    $('#DiscountAmount').attr('readonly', true);
                                    $('#PaymentMode').attr('disabled', true);
                                    $('#medSearch').attr('disabled', true);
                                    $('#barcodeInput').attr('disabled', true);
                                    $('#cartItems input, #cartItems select, #cartItems button').attr('disabled', true);
                                    $('#cartItemsMobile input, #cartItemsMobile select, #cartItemsMobile button').attr('disabled', true);

                                    // Replace Action Buttons with a green "Start New Bill" button
                                    $('#posActionButtons').html(`
                                        <button onclick="resetPOSCart(true)" class="btn btn-success btn-lg w-100 py-3 shadow-sm fw-bold">
                                            <i class="fas fa-plus-circle me-2"></i> START NEW BILL
                                        </button>
                                    `);
                                }
                            } else {
                                enableActionButtons();
                                toastr.error(res.message);
                            }
                        },
                        error: function() {
                            Swal.close();
                            enableActionButtons();
                            toastr.error("An error occurred while saving the sale.");
                        }
                    });
                }
            });
        }

        function resetPOSCart(unlock = false) {
            cart = [];
            renderCart();
            currentTransactionGuid = generateGuid();

            // Clear inputs
            $('#SelectedCustomerId').val('');
            $('#CustomerName').val('Walk-in Customer').removeAttr('readonly');
            $('#CustomerPhone').val('').removeAttr('readonly');
            $('#DiscountAmount').val('0').removeAttr('readonly');
            $('#PaymentMode').val('Cash').removeAttr('disabled');
            $('#medSearch').val(null).trigger('change').removeAttr('disabled');
            $('#barcodeInput').val('').removeAttr('disabled');

            // Restore action buttons if they were replaced during "stay" lock
            if (unlock) {
                $('#posActionButtons').html(`
                    <button onclick="processSale('print')" class="btn btn-primary btn-lg w-100 py-3 mb-2 shadow-sm fw-bold" id="btnSavePrint" tabindex="8">
                        <i class="fas fa-print me-2"></i> SAVE & PRINT [F10]
                    </button>
                    <div class="d-flex gap-2">
                        <button onclick="processSale('new')" class="btn btn-success btn-sm w-50 py-2 shadow-sm text-white fw-bold" id="btnSaveNew">
                            <i class="fas fa-plus me-1"></i> Save & New
                        </button>
                        <button onclick="processSale('stay')" class="btn btn-info btn-sm w-50 py-2 shadow-sm text-white fw-bold" id="btnSaveStay">
                            <i class="fas fa-save me-1"></i> Save & Stay
                        </button>
                    </div>
                `);
            }

            // Refocus first field
            setTimeout(() => {
                $('#medSearch').select2('open');
            }, 200);
        }
    </script>
}
