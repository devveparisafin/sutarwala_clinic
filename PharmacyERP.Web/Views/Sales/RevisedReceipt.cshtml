@{
    Layout = null; // No layout for printing
    var details = ViewBag.Details as IEnumerable<PharmacyERP.Web.Models.Entities.SaleDetail> ?? new List<PharmacyERP.Web.Models.Entities.SaleDetail>();
    var settings = ViewBag.Settings as PharmacyERP.Web.Models.ViewModels.SettingsViewModel;
    var medNames = ViewBag.MedicineNames as Dictionary<string, string> ?? new Dictionary<string, string>();
    var batchDict = ViewBag.BatchDetails as Dictionary<string, PharmacyERP.Web.Models.Entities.MedicineBatch> ?? new Dictionary<string, PharmacyERP.Web.Models.Entities.MedicineBatch>();

    // Filter for Active Items (Net Qty > 0)
    var activeItems = details.Where(d => (d.Qty - d.ReturnedQty) > 0).ToList();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Revised Invoice - @Model.InvoiceNo</title>
    <!-- Include Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            font-size: 11px;
            color: #333;
            background-color: #fff;
        }
        .invoice-container {
            width: 100%;
            max-width: 210mm;
            height: 148mm;
            margin: 0 auto;
            padding: 5mm;
            box-sizing: border-box;
            position: relative;
        }
        .header-section {
            border-bottom: 2px solid #0d6efd;
            padding-bottom: 5px;
            margin-bottom: 10px;
        }
        .store-name {
            font-size: 18px;
            font-weight: bold;
            color: #0d6efd;
        }
        .table-items th {
            background-color: #0d6efd !important;
            color: white !important;
            font-size: 10px;
            padding: 4px;
        }
        .table-items td {
            padding: 3px;
            font-size: 10px;
            border-bottom: 1px solid #dee2e6;
        }
        .summary-table td {
            padding: 2px 4px;
            font-size: 10px;
        }
        .grand-total {
            font-size: 14px;
            font-weight: bold;
            color: #0d6efd;
            background-color: #f8f9fa;
        }
        .footer-section {
            position: absolute;
            bottom: 5mm;
            left: 5mm;
            right: 5mm;
            border-top: 1px solid #dee2e6;
            padding-top: 5px;
        }
        .signature-area {
            text-align: right;
            padding-top: 20px;
        }
        .signature-line {
            border-top: 1px solid #333;
            width: 150px;
            display: inline-block;
            margin-top: 5px;
        }

        /* Print Specific Styles */
        @@media print {
            @@page {
                size: A5 landscape;
                margin: 0;
            }
            body {
                margin: 0;
                padding: 0;
            }
            .invoice-container {
                border: none;
                box-shadow: none;
                width: 210mm;
                height: 148mm;
                padding: 10mm;
            }
            .no-print {
                display: none !important;
            }
            .table-items th {
                background-color: #0d6efd !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
                color: white !important;
            }
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Top Section -->
        <div class="row header-section align-items-center">
            <div class="col-7">
                <div class="store-name">@(settings?.StoreName ?? "PHARMACY ERP")</div>
                <div>@(settings?.Address ?? "Store Address")</div>
                <div>Mobile: @(settings?.Phone ?? "N/A") | GST: @(settings?.GstInNumber ?? "N/A")</div>
            </div>
            <div class="col-5 text-end">
                <div class="h5 mb-1 text-danger">REVISED TAX INVOICE</div>
                <div class="small fw-bold text-muted mb-2">(AFTER RETURNS)</div>
                <div><strong>Invoice No:</strong> @Model.InvoiceNo</div>
                <div><strong>Date:</strong> @Model.SaleDate.ToString("dd/MM/yyyy HH:mm")</div>
                <div><strong>Cust:</strong> @Model.CustomerName</div>
                <div><strong>Mode:</strong> @Model.PaymentMode</div>
            </div>
        </div>

        <!-- Item Table -->
        <div class="row" style="min-height: 55mm;">
            <div class="col-12">
                <table class="table table-sm table-items">
                    <thead>
                        <tr>
                            <th style="width: 30%;">Item</th>
                            <th style="width: 12%;">Batch</th>
                            <th style="width: 12%;">Expiry</th>
                            <th style="width: 8%;" class="text-end">Orig. Qty</th>
                            <th style="width: 8%;" class="text-end">Ret. Qty</th>
                            <th style="width: 8%;" class="text-end fw-bold">Net Qty</th>
                            <th style="width: 10%;" class="text-end">MRP</th>
                            <th style="width: 10%;" class="text-end">Saving</th>
                            <th style="width: 18%;" class="text-end">Net Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            decimal mainSubTotal = 0;
                            decimal mainSaving = 0;
                            decimal mainTotal = 0;
                        }
                        @foreach (var item in activeItems)
                        {
                            var itm = medNames.ContainsKey(item.MedicineId) ? medNames[item.MedicineId] : "Item " + item.MedicineId;
                            var itemName = itm.Split("_")[0];
                            var itemUnit = itm.Split("_")[1];
                            
                            var batch = batchDict.ContainsKey(item.BatchId) ? batchDict[item.BatchId] : null;
                            var mrpPerUnit = Math.Round((1 * (batch?.MRP ?? 0)) / Convert.ToInt64(itemUnit), 2);
                            var salePerUnit = Math.Round((1 * (batch?.SaleRate ?? 0)) / Convert.ToInt64(itemUnit), 2); 
                            string batchNoStr = batch?.BatchNo ?? "N/A";
                            string expiryStr = batch?.ExpiryDate.ToString("MM/yy") ?? "N/A";
                            
                            int netQty = item.Qty - item.ReturnedQty;
                            
                            decimal mrpTotal = mrpPerUnit * netQty;
                            decimal saleTotal = salePerUnit * netQty;
                            decimal saleDisc = mrpTotal - saleTotal;

                            mainSubTotal += mrpTotal;
                            mainSaving += saleDisc;
                            mainTotal += saleTotal;

                            <tr>
                                <td class="fw-bold">@itemName</td>
                                <td>@batchNoStr</td>
                                <td>@expiryStr</td>
                                <td class="text-end text-muted">@item.Qty</td>
                                <td class="text-end text-danger">@item.ReturnedQty</td>
                                <td class="text-end fw-bold text-dark">@netQty</td>
                                <td class="text-end">@mrpPerUnit</td>
                                <td class="text-end">@saleDisc</td>
                                <td class="text-end fw-bold">@(mrpTotal - saleDisc)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Summary & Footer Section -->
        <div class="row mt-2">
            <!-- Left Side: Footer Message -->
            <div class="col-6 d-flex flex-column justify-content-between">
                <div style="font-size:10px;" class="text-muted">
                    <p><strong>Note:</strong> Items fully returned have been omitted from this revised invoice. 
                    <br/>Any previous versions of this invoice are superseded.</p>
                </div>
            </div>

            <!-- Right Side: Calculations -->
            <div class="col-6">
                <table class="table table-sm table-borderless summary-table">
                    <tr>
                        <td>Revised Sub Total:</td>
                        <td class="text-end">@mainSubTotal</td>
                    </tr>
                    <tr>
                        <td>Revised Saving:</td>
                        <td class="text-end text-success fw-bold">@mainSaving</td>
                    </tr>
                    <!-- Note: TaxAmount and DiscountAmount from original sale are skipped for simplicity in partial returns, 
                         or they would need complex recalculation. If you recalculate them, do it here. -->
                    <tr class="grand-total">
                        <td class="py-2">Revised Grand Total:</td>
                        <td class="text-end py-2">₹@mainTotal</td>
                    </tr>
                </table>
            </div>

             <div class="col-12 d-flex flex-column justify-content-between">
                <div class="signature-area">
                    <div class="signature-line"></div>
                    <div style="font-size: 9px;">Authorized Signature</div>
                </div>
            </div>
        </div>

        <!-- Action Buttons (No Print) -->
        <div class="text-center no-print mt-3">
            <button onclick="window.print()" class="btn btn-primary btn-sm"><i class="fas fa-print"></i> Print Invoice</button>
            <button onclick="window.close()" class="btn btn-secondary btn-sm ms-2">Close</button>
        </div>
    </div>

    <script>
        // Auto-print on load for POS systems
        window.onload = function() {
            setTimeout(function() {
                window.print();
            }, 500);
        };
    </script>
</body>
</html>
