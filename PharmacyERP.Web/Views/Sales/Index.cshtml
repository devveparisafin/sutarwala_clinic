@model IEnumerable<PharmacyERP.Web.Models.Entities.Sale>
@{
    ViewData["Title"] = "Sales History";
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4 mt-2">
        <h1 class="h3 mb-0 text-gray-800">Sales History</h1>
        <a asp-action="Pos" class="btn btn-primary shadow-sm">
            <i class="fas fa-desktop fa-sm text-white-50"></i> Go to POS Billing
        </a>
    </div>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">Recent Transactions</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="salesTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Invoice No</th>
                            <th>Date</th>
                            <th>Customer</th>
                            <th>Total Amount</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.OrderByDescending(x => x.SaleDate))
                        {
                            <tr>
                                <td class="font-weight-bold">@item.InvoiceNo</td>
                                <td>@item.SaleDate.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@item.CustomerName</td>
                                <td class="font-weight-bold text-success">₹@item.TotalAmount.ToString("N2")</td>
                                <td>
                                    <span class="badge bg-secondary">@item.PaymentMode</span>
                                </td>
                                <td>
                                    @if(item.Status == "Paid") {
                                        <span class="badge bg-success">Paid</span>
                                    } else if(item.Status == "Returned") {
                                        <span class="badge bg-danger">Returned</span>
                                    } else if(item.Status == "Partially Returned") {
                                        <span class="badge bg-danger">Partially Returned</span>
                                    } else {
                                        <span class="badge bg-warning text-dark">@item.Status</span>
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-info text-white mb-1" onclick="window.open('/Sales/Receipt/@item.Id', '_blank')" title="Print Original Receipt">
                                        <i class="fas fa-print"></i> Original
                                    </button>
                                    @if(item.Status == "Returned" || item.Status == "Partially Returned") {
                                        <button class="btn btn-sm btn-dark text-white mb-1" onclick="window.open('/Sales/RevisedReceipt/@item.Id', '_blank')" title="Print Revised A5 Bill">
                                            <i class="fas fa-file-invoice"></i> Revised (A5)
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#salesTable').DataTable({
                "order": [[ 1, "desc" ]] // Sort by Date descending
            });
        });
    </script>
}
